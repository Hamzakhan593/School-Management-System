@model School_Management_System.ViewModels.StaffFormViewModel
@{
    ViewData["Title"] = "Add Staff";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h1 class="h3 mb-1">Add Staff Member</h1><p class="text-muted mb-0">A unique employee ID will be generated automatically.</p></div>
    <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-lg-4">
        <form method="post">
            <partial name="_StaffForm" model="Model" />
            <div class="d-flex gap-2 mt-4">
                <button class="btn btn-primary" type="submit">Create Staff Profile</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
