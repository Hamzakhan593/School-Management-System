@model School_Management_System.ViewModels.StaffFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<input asp-for="Id" type="hidden" />
<input asp-for="RowVersion" type="hidden" />

@if (!string.IsNullOrWhiteSpace(Model.EmployeeId))
{
    <div class="alert alert-light border">
        <strong>Employee ID:</strong> @Model.EmployeeId
        <span class="text-muted ms-2">Employee ID is preserved and cannot be edited.</span>
    </div>
}

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Cnic" class="form-label"></label>
        <input asp-for="Cnic" class="form-control" placeholder="e.g. 42101-1234567-1" />
        <span asp-validation-for="Cnic" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Designation" class="form-label"></label>
        <input asp-for="Designation" class="form-control" placeholder="Teacher, Accountant, Clerk..." />
        <span asp-validation-for="Designation" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Department" class="form-label"></label>
        <input asp-for="Department" class="form-control" placeholder="Academic, Accounts, Admin..." />
        <span asp-validation-for="Department" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="JoiningDate" class="form-label"></label>
        <input asp-for="JoiningDate" class="form-control" />
        <span asp-validation-for="JoiningDate" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="EmploymentType" class="form-label"></label>
        <select asp-for="EmploymentType" class="form-select" asp-items="Html.GetEnumSelectList<StaffEmploymentType>()"></select>
        <span asp-validation-for="EmploymentType" class="text-danger"></span>
    </div>
    @if (Model.Id > 0)
    {
        <div class="col-md-4">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select">
                <option value="@((int)StaffStatus.Active)">Active</option>
                <option value="@((int)StaffStatus.OnLeave)">On Leave</option>
                <option value="@((int)StaffStatus.Inactive)">Inactive</option>
            </select>
            <div class="form-text">For Resigned / Terminated / Retired use the Mark Exit action.</div>
        </div>
    }
    <div class="col-12">
        <label asp-for="Qualification" class="form-label"></label>
        <textarea asp-for="Qualification" class="form-control" rows="2" placeholder="Highest qualification, specialization, certifications..."></textarea>
        <span asp-validation-for="Qualification" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Address" class="form-label"></label>
        <textarea asp-for="Address" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>
</div>
