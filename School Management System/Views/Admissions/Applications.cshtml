@model School_Management_System.ViewModels.AdmissionApplicationsIndexViewModel
@{
    ViewData["Title"] = "Admission Applications";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div><h2 class="mb-1">Admission Applications</h2><p class="text-muted mb-0">Draft, submitted and admitted student applications.</p></div>
    <a asp-action="Index" class="btn btn-outline-secondary">Enquiry Register</a>
</div>
<div class="card border-0 shadow-sm mb-4"><div class="card-body"><form method="get" class="row g-2 align-items-end">
    <div class="col-md-6"><label class="form-label">Search</label><input name="q" value="@Model.Query" class="form-control" placeholder="Student, admission no or guardian phone" /></div>
    <div class="col-md-4"><label class="form-label">Status</label><select name="status" class="form-select"><option value="">All statuses</option>@foreach (var s in Enum.GetValues<AdmissionApplicationStatus>()) { <option value="@s" selected="@(Model.Status == s)">@s</option> }</select></div>
    <div class="col-md-2 d-grid"><button class="btn btn-outline-primary">Filter</button></div>
</form></div></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Student</th><th>Status</th><th>Admission no.</th><th>Class</th><th>Session</th><th>Guardian phone</th><th></th></tr></thead><tbody>
@if (!Model.Applications.Any()) { <tr><td colspan="7" class="text-center text-muted py-4">No admission applications found.</td></tr> }
@foreach (var item in Model.Applications) { <tr><td class="fw-semibold">@item.StudentName</td><td><span class="badge text-bg-secondary">@item.Status</span></td><td>@(item.AdmissionNumber ?? "-")</td><td>@item.DesiredClass</td><td>@item.AcademicSession.Name</td><td>@item.GuardianPhone</td><td class="text-end"><a asp-action="ApplicationDetails" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Open</a></td></tr> }
</tbody></table></div></div>
