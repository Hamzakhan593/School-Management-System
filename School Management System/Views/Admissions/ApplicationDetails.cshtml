@model AdmissionApplication
@{
    ViewData["Title"] = "Admission Application";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div><h2 class="mb-1">@Model.StudentName</h2><p class="text-muted mb-0">Admission application #@Model.Id · @Model.Status</p></div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Applications" class="btn btn-outline-secondary">Back</a>
        @if (Model.Status == AdmissionApplicationStatus.Draft) { <a asp-action="EditApplication" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit Form</a> }
    </div>
</div>

@if (Model.Status == AdmissionApplicationStatus.Admitted)
{
    <div class="alert alert-success"><strong>Admission completed.</strong> Admission Number: <span class="fw-bold">@Model.AdmissionNumber</span> <a class="btn btn-primary ms-2" asp-controller="Students" asp-action="Details" asp-route-id="@Model.StudentId">Open Student Profile</a></div>
}

<div class="row g-3 mb-4">
    <div class="col-lg-8"><div class="card border-0 shadow-sm"><div class="card-body">
        <h5>Student & Admission</h5><div class="row g-3 mb-4">
            <div class="col-md-4"><div class="text-muted small">Academic session</div><div>@Model.AcademicSession.Name</div></div>
            <div class="col-md-4"><div class="text-muted small">Desired class</div><div>@Model.DesiredClass</div></div>
            <div class="col-md-4"><div class="text-muted small">Admission date</div><div>@Model.AdmissionDate.ToString("dd MMM yyyy")</div></div>
            <div class="col-md-4"><div class="text-muted small">Date of birth</div><div>@Model.DateOfBirth.ToString("dd MMM yyyy")</div></div>
            <div class="col-md-4"><div class="text-muted small">Gender</div><div>@(Model.Gender ?? "-")</div></div>
            <div class="col-md-4"><div class="text-muted small">B-Form / CNIC</div><div>@(Model.BFormCnic ?? "-")</div></div>
            <div class="col-12"><div class="text-muted small">Address</div><div>@(Model.Address ?? "-")</div></div>
        </div>
        <h5>Guardian</h5><div class="row g-3 mb-4">
            <div class="col-md-4"><div class="text-muted small">Name</div><div>@Model.GuardianName</div></div>
            <div class="col-md-4"><div class="text-muted small">Relationship</div><div>@Model.GuardianRelationship</div></div>
            <div class="col-md-4"><div class="text-muted small">Phone</div><div>@Model.GuardianPhone</div></div>
            <div class="col-md-4"><div class="text-muted small">Occupation</div><div>@(Model.GuardianOccupation ?? "-")</div></div>
            <div class="col-md-4"><div class="text-muted small">CNIC</div><div>@(Model.GuardianCnic ?? "-")</div></div>
            <div class="col-md-4"><div class="text-muted small">Emergency phone</div><div>@(Model.EmergencyContactPhone ?? "-")</div></div>
        </div>
        <h5>Previous School</h5><p class="mb-1">@(Model.PreviousSchoolName ?? "-") · @(Model.PreviousClass ?? "-")</p><p class="text-muted">@(Model.PreviousResultSummary ?? "No result remarks")</p>
        @if (!string.IsNullOrWhiteSpace(Model.Notes)) { <h5>Notes</h5><p>@Model.Notes</p> }
    </div></div></div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-3"><div class="card-body">
            <h5 class="card-title">Next step</h5>
            @if (Model.Status == AdmissionApplicationStatus.Draft)
            {
                <p class="small text-muted">Review the form and documents, then submit it for final admission approval.</p>
                <form asp-action="SubmitApplication" method="post"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-primary w-100">Submit for approval</button></form>
            }
            else if (Model.Status == AdmissionApplicationStatus.Submitted)
            {
                <p class="small text-muted">Approve the reviewed application to create the student profile and admission number.</p>
                <form asp-action="Admit" method="post" class="mb-2"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-success w-100">Approve & Admit Student</button></form>
                <form asp-action="RejectApplication" method="post"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-outline-danger w-100" onclick="return confirm('Reject this admission application?')">Reject Application</button></form>
            }
            else if (Model.Status == AdmissionApplicationStatus.Rejected)
            {
                <div class="text-danger">This application was rejected.</div>
            }
            else
            {
                <div class="text-success">Student record created. Open the profile to check class / section placement before marking attendance.</div>
            }
        </div></div>
        <div class="alert alert-info small"><strong>Next step:</strong> Generate the initial fee challan after admission. @if (Model.Status == AdmissionApplicationStatus.Admitted && Model.StudentId.HasValue && (User.IsInRole(AppRoles.SuperAdmin) || User.IsInRole(AppRoles.Principal) || User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Accountant))) { <a asp-controller="Fees" asp-action="Generate" asp-route-studentId="@Model.StudentId" asp-route-academicSessionId="@Model.AcademicSessionId" class="alert-link">Generate this student's initial challan</a> }</div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center"><span class="fw-semibold">Admission Documents</span><span class="small text-muted">PDF/JPG/PNG · max 5 MB</span></div>
    <div class="card-body">
        @if (Model.Status == AdmissionApplicationStatus.Draft)
        {
            <form asp-action="UploadDocument" method="post" enctype="multipart/form-data" class="row g-2 align-items-end mb-4">
                <input type="hidden" name="AdmissionApplicationId" value="@Model.Id" />
                <div class="col-md-4"><label class="form-label">Document type</label><select name="DocumentType" asp-items="Html.GetEnumSelectList<AdmissionDocumentType>()" class="form-select"></select></div>
                <div class="col-md-6"><label class="form-label">File</label><input type="file" name="File" class="form-control" accept=".pdf,.jpg,.jpeg,.png" required /></div>
                <div class="col-md-2 d-grid"><button class="btn btn-outline-primary">Upload</button></div>
            </form>
        }
        @if (!Model.Documents.Any()) { <div class="text-muted">No documents uploaded yet.</div> }
        else
        {
            <div class="table-responsive"><table class="table align-middle mb-0"><thead class="table-light"><tr><th>Type</th><th>File</th><th>Size</th><th></th></tr></thead><tbody>
            @foreach (var doc in Model.Documents.OrderBy(x => x.DocumentType)) { <tr><td>@doc.DocumentType</td><td>@doc.OriginalFileName</td><td>@((doc.SizeBytes / 1024d).ToString("N0")) KB</td><td class="text-end"><a asp-action="DownloadDocument" asp-route-id="@doc.Id" class="btn btn-sm btn-outline-secondary">Download</a></td></tr> }
            </tbody></table></div>
        }
    </div>
</div>
