@model School_Management_System.ViewModels.AdmissionEnquiryFormViewModel
@{
    ViewData["Title"] = "Edit Admission Enquiry";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h2 class="mb-1">Edit Admission Enquiry</h2><p class="text-muted mb-0">Update follow-up details and stage.</p></div>
    <a asp-action="EnquiryDetails" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Back</a>
</div>
<div class="card shadow-sm border-0"><div class="card-body p-4">
    <form asp-action="EditEnquiry" method="post">
        <input asp-for="Id" type="hidden" />
        <partial name="_EnquiryForm" model="Model" />
        <div class="mt-4"><button class="btn btn-primary" type="submit">Save Changes</button></div>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
