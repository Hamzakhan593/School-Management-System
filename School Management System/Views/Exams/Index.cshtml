@model School_Management_System.ViewModels.ExamIndexViewModel
@{
    ViewData["Title"] = "Exams & results";
    var canManage = User.IsInRole(AppRoles.SuperAdmin) || User.IsInRole(AppRoles.Principal) || User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.ExamController);
}
<link rel="stylesheet" href="~/css/results-workspace.css" asp-append-version="true" />
<div class="results-workspace">
<header class="results-heading"><div><span class="results-eyebrow">EXAMS &amp; RESULTS</span><h1>Your examinations</h1><p>Choose an exam to set up classes, enter marks or prepare result cards.</p></div>@if(canManage){<a class="btn btn-primary" asp-action="Create" asp-route-sessionId="@Model.SelectedSessionId">Create an exam</a>}</header>
<nav class="results-nav" aria-label="Exams and results"><a asp-action="Index" aria-current="page">Exams</a><a asp-action="Workspace">Enter marks</a><a asp-controller="Results" asp-action="Index" asp-route-sessionId="@Model.SelectedSessionId">Result cards</a></nav>
<form method="get" class="results-panel results-filters"><div><label for="examSession">Academic session</label><select id="examSession" name="sessionId" class="form-select">@foreach(var session in Model.Sessions){<option value="@session.Id" selected="@(session.Id == Model.SelectedSessionId)">@session.Name</option>}</select></div><button class="btn btn-outline-primary">Show exams</button></form>
@if(!Model.Sessions.Any()){<div class="results-empty">Create an academic session before adding exams.</div>}else if(!Model.Exams.Any()){<div class="results-empty">No exams in this session yet. Use Create an exam to get started.</div>}else{
<div class="results-search"><label for="examSearch">Find an exam<input id="examSearch" class="form-control" type="search" placeholder="Search by exam name" /></label></div>
<div class="exam-directory">
@foreach(var exam in Model.Exams){
    var status = exam.Status switch { ExamStatus.Draft => "Setup needed", ExamStatus.MarksEntryOpen => "Marks entry open", ExamStatus.MarksLocked => "Ready for results", ExamStatus.Published => "Results published", _ => "Archived" };
<article class="results-panel exam-card" data-exam-name="@exam.Title">
<div class="exam-card-heading"><div><h2>@exam.Title</h2><p>@exam.AcademicSession.Name · @exam.ExamType@(exam.Term is null ? "" : " · " + exam.Term.Name)</p></div><span class="result-status @(exam.Status == ExamStatus.Published ? "is-published" : "")">@status</span></div>
<div class="exam-facts"><div><span>Starts</span><strong class="exam-date">@exam.StartDate.ToString("dd MMM yyyy")</strong></div><div><span>Ends</span><strong class="exam-date">@exam.EndDate.ToString("dd MMM yyyy")</strong></div><div><span>Classes</span><strong>@exam.ExamClasses.Count assigned</strong></div></div>
@if(exam.ExamClasses.Any()){<details class="exam-class-list"><summary>View assigned classes</summary><div class="result-chips">@foreach(var item in exam.ExamClasses.OrderBy(x=>x.SchoolClass.SortOrder)){<span>@item.SchoolClass.Name</span>}</div></details>}else{<p class="results-note">Add classes and subjects in exam setup before entering marks.</p>}
<div class="results-actions">
@if(exam.Status == ExamStatus.MarksEntryOpen){<a class="btn btn-primary" asp-action="Workspace" asp-route-examId="@exam.Id">Enter / review marks</a>}
@if(exam.Status == ExamStatus.MarksLocked || exam.Status == ExamStatus.Published || exam.Status == ExamStatus.Archived){<a class="btn btn-primary" asp-controller="Results" asp-action="Index" asp-route-sessionId="@exam.AcademicSessionId" asp-fragment="exam-@exam.Id">Open result cards</a>}
<a class="btn @(exam.Status == ExamStatus.Draft ? "btn-primary" : "btn-outline-secondary")" asp-action="Details" asp-route-id="@exam.Id">@(exam.Status == ExamStatus.Draft ? "Set up exam" : "Exam details")</a>
@if(!exam.IsActive){<span class="results-note">Inactive exam</span>}
</div></article>
}
</div><p id="examSearchEmpty" class="results-empty" hidden>No matching exams.</p>
}
</div>
@section Scripts { <script src="~/js/results-workspace.js" asp-append-version="true"></script> }
