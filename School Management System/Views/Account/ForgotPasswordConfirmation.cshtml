@{
    ViewData["Title"] = "Reset Request";
    var developerLink = TempData["DeveloperResetLink"] as string;
}

<div class="auth-shell">
    <div class="auth-card shadow-sm">
        <h1 class="h3">Reset request received</h1>
        <p>If the account exists and is active, a password reset request has been created.</p>
        @if (!string.IsNullOrWhiteSpace(developerLink))
        {
            <div class="alert alert-warning">
                <strong>Development only:</strong> communication/email is not connected yet.<br />
                <a href="@developerLink">Open password reset link</a>
            </div>
        }
        <a asp-action="Login" class="btn btn-outline-primary w-100">Back to login</a>
    </div>
</div>
