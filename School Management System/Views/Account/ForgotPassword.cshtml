@model School_Management_System.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-shell">
    <div class="auth-card shadow-sm">
        <h1 class="h3">Forgot password</h1>
        <p class="text-secondary">Enter your account email. In development, the reset link is shown on the next screen; production delivery will later connect to the communication module.</p>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <button class="btn btn-primary w-100" type="submit">Create reset request</button>
        </form>
        <a asp-action="Login" class="d-block mt-3 text-center">Back to login</a>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
