@model School_Management_System.ViewModels.ExpenseReportViewModel
@{
    ViewData["Title"] = "Expense Report";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h2 class="mb-1">Expense Report</h2><div class="text-muted">Monthly expense detail and category breakdown.</div></div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
</div>
<form method="get" class="card card-body shadow-sm mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-2"><label class="form-label">Year</label><input name="year" value="@Model.Year" type="number" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">Month</label><select name="month" class="form-select">@for (var i = 1; i <= 12; i++)
            {
                if (i == Model.Month)
                {
                    <option value="@i" selected>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                }
                else
                {
                    <option value="@i">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                }
            }</select></div>
        <div class="col-md-4"><label class="form-label">Category</label><select name="categoryId" class="form-select"><option value="">All categories</option>@foreach (var c in Model.Categories)
            {
                if (Model.ExpenseCategoryId == c.Id)
                {
                    <option value="@c.Id" selected>@c.Name</option>
                }
                else
                {
                    <option value="@c.Id">@c.Name</option>
                }
            }</select></div>
        <div class="col-md-2"><button class="btn btn-primary" type="submit">Apply</button></div>
    </div>
</form>
<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Approved / Countable</div><div class="fs-4 fw-semibold">Rs. @Model.ApprovedTotal.ToString("N2")</div></div></div></div>
    <div class="col-md-4"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Pending</div><div class="fs-4 fw-semibold">Rs. @Model.PendingTotal.ToString("N2")</div></div></div></div>
    <div class="col-md-4"><div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Rejected</div><div class="fs-4 fw-semibold">Rs. @Model.RejectedTotal.ToString("N2")</div></div></div></div>
</div>
<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm"><div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0"><thead class="table-light"><tr><th>Date</th><th>Category</th><th>Paid To</th><th>Amount</th><th>Status</th><th>Reference</th></tr></thead><tbody>
        @foreach(var e in Model.Expenses){<tr><td>@e.ExpenseDate.ToString("dd MMM yyyy")</td><td>@e.ExpenseCategory.Name</td><td>@e.PaidTo</td><td>Rs. @e.Amount.ToString("N2")</td><td>@e.ApprovalStatus</td><td>@e.ReferenceNumber</td></tr>}
        @if(Model.Expenses.Count==0){<tr><td colspan="6" class="text-center text-muted py-4">No records for this filter.</td></tr>}
        </tbody></table></div></div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm"><div class="card-header fw-semibold">Approved by Category</div><div class="table-responsive"><table class="table table-sm mb-0"><tbody>@foreach(var c in Model.CategoryTotals){<tr><td>@c.Category</td><td class="text-end">Rs. @c.Amount.ToString("N2")</td></tr>}@if(Model.CategoryTotals.Count==0){<tr><td class="text-muted">No approved totals.</td></tr>}</tbody></table></div></div>
    </div>
</div>
