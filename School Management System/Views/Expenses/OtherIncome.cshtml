@model School_Management_System.ViewModels.OtherIncomeIndexViewModel
@{
    ViewData["Title"] = "Other Income";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h2 class="mb-1">Other Recorded Income</h2><div class="text-muted">Non-fee income included in the simple financial summary.</div></div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Expenses</a>
</div>
<div class="row g-4">
    <div class="col-lg-4">
        <div class="card shadow-sm"><div class="card-header fw-semibold">Record Income</div><div class="card-body">
            <form asp-action="AddOtherIncome" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3"><label class="form-label">Date</label><input asp-for="Form.IncomeDate" name="IncomeDate" type="date" class="form-control" /></div>
                <div class="mb-3"><label class="form-label">Amount (Rs.)</label><input asp-for="Form.Amount" name="Amount" class="form-control" step="0.01" /></div>
                <div class="mb-3"><label class="form-label">Source</label><input asp-for="Form.Source" name="Source" class="form-control" placeholder="Donation, sale, rental, etc." /></div>
                <div class="mb-3"><label class="form-label">Payment Method</label><select asp-for="Form.PaymentMethod" name="PaymentMethod" asp-items="Html.GetEnumSelectList<ExpensePaymentMethod>()" class="form-select"></select></div>
                <div class="mb-3"><label class="form-label">Reference</label><input asp-for="Form.ReferenceNumber" name="ReferenceNumber" class="form-control" /></div>
                <div class="mb-3"><label class="form-label">Notes</label><textarea asp-for="Form.Notes" name="Notes" class="form-control" rows="2"></textarea></div>
                <button class="btn btn-primary" type="submit">Save Income</button>
            </form>
        </div></div>
    </div>
    <div class="col-lg-8">
        <form method="get" class="card card-body shadow-sm mb-3"><div class="row g-2 align-items-end"><div class="col-4"><label class="form-label">Year</label><input name="year" value="@Model.Year" class="form-control" type="number" /></div><div class="col-4"><label class="form-label">Month</label><select name="month" class="form-select">@for (var i = 1; i <= 12; i++)
            {
                if (i == Model.Month)
                {
                    <option value="@i" selected>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                }
                else
                {
                    <option value="@i">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                }
            }</select></div><div class="col-4"><button class="btn btn-outline-primary" type="submit">View</button></div></div></form>
        <div class="alert alert-info">Active income for selected month: <strong>Rs. @Model.MonthTotal.ToString("N2")</strong></div>
        <div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Date</th><th>Source</th><th>Amount</th><th>Method</th><th>Reference</th><th>Status / Action</th></tr></thead><tbody>
            @foreach(var item in Model.Items){<tr class="@(item.IsCancelled ? "table-secondary" : "")"><td>@item.IncomeDate.ToString("dd MMM yyyy")</td><td>@item.Source</td><td>Rs. @item.Amount.ToString("N2")</td><td>@item.PaymentMethod</td><td>@item.ReferenceNumber</td><td>@if(item.IsCancelled){<span class="badge text-bg-secondary">Cancelled</span><div class="small text-muted">@item.CancellationReason</div>}else{<form asp-action="CancelOtherIncome" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@item.Id" /><input name="reason" class="form-control form-control-sm" placeholder="Reason" required /><button class="btn btn-sm btn-outline-danger" type="submit">Cancel</button></form>}</td></tr>}
            @if(Model.Items.Count==0){<tr><td colspan="6" class="text-center text-muted py-4">No other-income entries for this month.</td></tr>}
        </tbody></table></div></div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
