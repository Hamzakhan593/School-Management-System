@model School_Management_System.ViewModels.ResultsIndexViewModel
@{
    ViewData["Title"] = "Result cards";
    var canManage = User.IsInRole(AppRoles.SuperAdmin) || User.IsInRole(AppRoles.Principal) || User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.ExamController);
}
<link rel="stylesheet" href="~/css/results-workspace.css" asp-append-version="true" />
<div class="results-workspace">
<header class="results-heading"><div><span class="results-eyebrow">RESULT CARDS</span><h1>Review &amp; download results</h1><p>Choose an exam, then choose a class or download results for the whole school.</p></div></header>
<nav class="results-nav" aria-label="Exams and results"><a asp-controller="Exams" asp-action="Index" asp-route-sessionId="@Model.SelectedSessionId">Exams</a><a asp-controller="Exams" asp-action="Workspace">Enter marks</a><a asp-action="Index" aria-current="page">Result cards</a></nav>
<form method="get" class="results-panel results-filters"><div><label for="resultSession">Academic session</label><select id="resultSession" name="sessionId" class="form-select">@foreach(var session in Model.Sessions){<option value="@session.Id" selected="@(Model.SelectedSessionId == session.Id)">@session.Name</option>}</select></div><button class="btn btn-outline-primary">Show results</button></form>
@if(!Model.Exams.Any()){<div class="results-panel"><h2>No results ready yet</h2><p>Approve the subject marks and lock the exam first. It will then appear here.</p><a class="btn btn-primary" asp-controller="Exams" asp-action="Index">Go to exams</a></div>}
@foreach(var exam in Model.Exams){
<details class="results-panel result-exam" id="exam-@exam.Id" open="@(Model.Exams.Count == 1)">
<summary><span><strong>@exam.Title</strong><small>@exam.AcademicSession.Name · @exam.ExamType</small></span><span class="result-status">@(exam.Status == ExamStatus.MarksLocked ? "Ready to publish" : exam.Status == ExamStatus.Published ? "Published results" : "Archived")</span></summary>
<div class="result-exam-body"><h2>Which results do you need?</h2><p class="results-note">Open a class to review students, publish results or download individual and class cards.</p>
<div class="result-class-grid">@foreach(var item in exam.ExamClasses.OrderBy(x=>x.SchoolClass.SortOrder).ThenBy(x=>x.SchoolClass.Name)){
<a class="result-class-link" asp-action="ClassResult" asp-route-examId="@exam.Id" asp-route-classId="@item.SchoolClassId"><strong>@item.SchoolClass.Name</strong><span>Review students &amp; result cards →</span></a>}
</div>
@if(!exam.ExamClasses.Any()){<p class="results-empty">No classes assigned to this exam.</p>}
@if(canManage){
<div class="result-school-actions"><div><h3>Whole-school results</h3><p>Download all published classes together in one PDF.</p></div>@if(exam.Status == ExamStatus.Published){<a class="btn btn-primary" asp-action="AllResultCardsPdf" asp-route-examId="@exam.Id">Download school PDF</a>}else{<span class="results-note">Publish results first to enable download.</span>}</div>
@if(exam.Status != ExamStatus.Archived){<details class="result-publish"><summary>Publish results for remaining classes</summary><p>Creates results for classes that have no published results yet. Open an individual class for corrections.</p><form asp-action="PublishSchool" method="post"><input type="hidden" name="examId" value="@exam.Id" /><button class="btn btn-outline-primary">Publish remaining classes</button></form></details>}
}
</div></details>
}
</div>
@section Scripts { <script src="~/js/results-workspace.js" asp-append-version="true"></script> }
