@model School_Management_System.ViewModels.ClassResultViewModel
@{
    ViewData["Title"] = "Class Result";
    var canManage = User.IsInRole("SuperAdmin") || User.IsInRole("Principal") || User.IsInRole("Admin") || User.IsInRole("ExamController");
}

<link rel="stylesheet" href="~/css/results-workspace.css" asp-append-version="true" />
<div class="results-workspace">
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h2 class="mb-1">@Model.Exam.Title — @Model.SchoolClass.Name</h2>
        <div class="text-muted">Section: @(Model.Section?.Name ?? "All Sections") · Status: @Model.Exam.Status</div>
    </div>
    <div class="results-actions">
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        <a asp-action="SubjectPerformance" asp-route-examId="@Model.Exam.Id" asp-route-classId="@Model.SchoolClass.Id" asp-route-sectionId="@Model.Section?.Id" class="btn btn-outline-primary">Subject Analysis</a>
        <a asp-action="ClassResultSheetPdf" asp-route-examId="@Model.Exam.Id" asp-route-classId="@Model.SchoolClass.Id" asp-route-sectionId="@Model.Section?.Id" class="btn btn-outline-dark">Summary sheet · PDF</a>
        @if (Model.HasPublishedResults)
        {
            <a asp-action="BulkResultCardsPdf" asp-route-examId="@Model.Exam.Id" asp-route-classId="@Model.SchoolClass.Id" asp-route-sectionId="@Model.Section?.Id" class="btn btn-success">Class cards · PDF</a>
        }
    </div>
</div>

@if (Model.Sections.Count > 0)
{
    <form method="get" asp-action="ClassResult" class="card card-body mb-3">
        <input type="hidden" name="examId" value="@Model.Exam.Id" />
        <input type="hidden" name="classId" value="@Model.SchoolClass.Id" />
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Section</label>
                <select name="sectionId" class="form-select">
                    <option value="">All Sections</option>
                    @foreach (var sec in Model.Sections)
                    {
                        <option value="@sec.Id" selected="@(Model.Section?.Id == sec.Id)">@sec.Name</option>
                    }
                </select>
            </div>
            <div class="col-auto"><button class="btn btn-primary">Load</button></div>
        </div>
    </form>
}

@if (Model.MissingMarksCount > 0) { <div class="alert alert-warning">@Model.MissingMarksCount student(s) still need complete marks. Finish all subjects before publishing this class.</div> }
<p class="results-note">Class positions include all sections. Equal percentages share a position.</p>
@if (Model.Rows.Count == 0)
{
    <div class="alert alert-warning">No calculable student marks were found for this class/section.</div>
}
else
{
    <form asp-action="SelectedResultCardsPdf" method="post" class="card mb-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="examId" value="@Model.Exam.Id" />
        <input type="hidden" name="classId" value="@Model.SchoolClass.Id" />
        <input type="hidden" name="sectionId" value="@Model.Section?.Id" />
        <div class="result-roster-toolbar p-3"><label for="resultStudentSearch">Find a student<input type="search" class="form-control" id="resultStudentSearch" placeholder="Name, roll or admission number" /></label><span id="resultSearchCount" role="status">@Model.Rows.Count students shown</span><label class="result-select-all"><input type="checkbox" class="form-check-input" id="selectAllResults" /> Select all published students</label></div>
        <div class="card-body p-0 table-responsive">
            <table class="table table-striped table-hover mb-0 align-middle result-student-table">
                <thead class="table-light">
                    <tr>
                        <th>Select</th><th>Student</th><th>Marks</th><th>Percentage</th><th>Position</th><th>Result</th><th>Action</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr data-result-student="@row.StudentName @row.AdmissionNumber @row.RollNumber">
                        <td>@if(row.PublishedVersion.HasValue){<input class="form-check-input" type="checkbox" name="studentIds" value="@row.StudentId" aria-label="Select @row.StudentName" />}</td>
                        <td class="result-student-name"><strong>@row.StudentName</strong><small>Roll @(row.RollNumber ?? "-") - @row.AdmissionNumber</small><small>Attendance: @(row.AttendancePercentage.HasValue ? row.AttendancePercentage.Value.ToString("0.00") + "%" : "Not recorded")</small></td>
                        <td class="result-number">@row.ObtainedMarks.ToString("0.##") / @row.MaximumMarks.ToString("0.##")</td>
                        <td class="result-number">@row.Percentage.ToString("0.00")%</td>
                        <td class="result-number">@(row.Position?.ToString() ?? "-")</td>
                        <td><span class="result-status">@row.Grade - @(row.IsPassed ? "Pass" : "Fail")</span><small>@(row.PublishedVersion.HasValue ? "Published - v" + row.PublishedVersion : "Preview")</small></td>
                        <td>@if(row.PublishedVersion.HasValue){<a class="btn btn-sm btn-outline-primary" asp-action="ResultCard" asp-route-examId="@Model.Exam.Id" asp-route-studentId="@row.StudentId">View card</a>}</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (Model.HasPublishedResults)
        {
            <div class="card-footer results-actions"><span id="resultSelectedCount" role="status">0 selected</span><button id="downloadSelectedResults" class="btn btn-outline-success">Download selected cards</button></div>
        }
    </form>
}

@if (canManage && Model.Rows.Count > 0)
{
    @if (!Model.HasPublishedResults && Model.CanPublish)
    {
        <form asp-action="Publish" method="post" class="card card-body border-success mb-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="examId" value="@Model.Exam.Id" />
            <input type="hidden" name="classId" value="@Model.SchoolClass.Id" />
            <input type="hidden" name="sectionId" value="@Model.Section?.Id" />
            <h5>Publish Results</h5>
            <p class="text-muted mb-2">Generate the final totals, percentages and grades for these students. Then download their result cards below.</p>
            <div><button class="btn btn-success" onclick="return confirm('Publish these results?')">Publish @Model.Rows.Count Result(s)</button></div>
        </form>
    }
    else if (Model.HasPublishedResults && Model.Exam.Status == ExamStatus.Published)
    {
        <div class="card card-body border-warning mb-3">
            <h5>Controlled Correction</h5>
            <p class="text-muted">Published marks cannot be silently overwritten. Start correction mode, reopen only the required marks sheet, edit and lock it again, then return here to publish a new result version.</p>
            <form asp-action="BeginCorrection" method="post" class="row g-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="examId" value="@Model.Exam.Id" />
                <div class="col-md-8"><input class="form-control" name="reason" maxlength="500" placeholder="Required reason for correction" required /></div>
                <div class="col-auto"><button class="btn btn-warning" onclick="return confirm('Start controlled correction mode?')">Start Correction</button></div>
            </form>
        </div>
    }
    else if (Model.HasPublishedResults && Model.Exam.Status == ExamStatus.MarksLocked)
    {
        <form asp-action="Publish" method="post" class="card card-body border-warning mb-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="examId" value="@Model.Exam.Id" />
            <input type="hidden" name="classId" value="@Model.SchoolClass.Id" />
            <input type="hidden" name="sectionId" value="@Model.Section?.Id" />
            <h5>Publish Corrected Version</h5>
            <p class="text-muted">Existing published result stays in history as superseded. A new current version will be created.</p>
            <div class="row g-2">
                <div class="col-md-8"><input class="form-control" name="correctionReason" maxlength="500" placeholder="Required correction reason" required /></div>
                <div class="col-auto"><button class="btn btn-warning" onclick="return confirm('Publish corrected result version?')">Publish New Version</button></div>
            </div>
        </form>
    }
    else if (Model.Exam.Status == ExamStatus.MarksEntryOpen && Model.HasPublishedResults)
    {
        <div class="alert alert-warning">Correction is in progress. Finish marks correction in <strong>Exams & Marks</strong>, verify/lock the changed sheet, then use <strong>Lock Exam</strong>. Return here after the exam becomes MarksLocked.</div>
    }
}

</div>

@section Scripts { <script src="~/js/results-workspace.js" asp-append-version="true"></script> }
