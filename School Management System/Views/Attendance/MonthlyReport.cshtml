@model School_Management_System.ViewModels.MonthlyAttendanceReportViewModel
@{
    ViewData["Title"] = "Monthly Attendance Report";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="mb-1">Monthly Attendance Report</h2>
        <div class="text-muted">Attendance percentage and low-attendance identification.</div>
    </div>
    <a class="btn btn-outline-primary" asp-action="Index"
       asp-route-academicSessionId="@Model.AcademicSessionId"
       asp-route-schoolClassId="@Model.SchoolClassId"
       asp-route-sectionId="@Model.SectionId">Back to Daily Attendance</a>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form method="get" asp-action="MonthlyReport" class="row g-3 align-items-end">
            <div class="col-lg-3 col-md-6">
                <label class="form-label">Academic Session</label>
                <select class="form-select" name="academicSessionId">
                    @foreach (var session in Model.Sessions)
                    {
                        <option value="@session.Id" selected="@(session.Id == Model.AcademicSessionId)">@session.Name</option>
                    }
                </select>
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label">Class</label>
                <select class="form-select" name="schoolClassId">
                    <option value="">-- Select class --</option>
                    @foreach (var schoolClass in Model.Classes)
                    {
                        <option value="@schoolClass.Id" selected="@(schoolClass.Id == Model.SchoolClassId)">@schoolClass.Name</option>
                    }
                </select>
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label">Section</label>
                <select class="form-select" name="sectionId">
                    <option value="">-- All / none --</option>
                    @foreach (var section in Model.Sections)
                    {
                        <option value="@section.Id" selected="@(section.Id == Model.SectionId)">@section.Name</option>
                    }
                </select>
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label">Month</label>
                <input class="form-control" type="month" name="month" value="@Model.Month.ToString("yyyy-MM")" />
            </div>
            <div class="col-lg-2 col-md-6">
                <button class="btn btn-primary w-100" type="submit">View Report</button>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.AccessMessage))
{
    <div class="alert alert-info">@Model.AccessMessage</div>
}

@if (Model.Students.Count > 0)
{
    <div class="mb-3 d-flex flex-wrap justify-content-between gap-2">
        <div>
            <strong>@Model.SelectedClassName</strong>
            @if (!string.IsNullOrWhiteSpace(Model.SelectedSectionName))
            {
                <span> / @Model.SelectedSectionName</span>
            }
            <span class="text-muted">— @Model.Month.ToString("MMMM yyyy")</span>
        </div>
        <span class="badge text-bg-warning">Low attendance: below @Model.LowAttendanceThresholdPercent.ToString("0.##")%</span>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Student</th>
                        <th>Admission / Roll</th>
                        <th class="text-center">Marked</th>
                        <th class="text-center">Present</th>
                        <th class="text-center">Absent</th>
                        <th class="text-center">Late</th>
                        <th class="text-center">Leave</th>
                        <th class="text-center">Half Day</th>
                        <th class="text-end">Attendance %</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.Students)
                {
                    <tr class="@(row.IsLowAttendance ? "table-warning" : null)">
                        <td class="fw-semibold">@row.StudentName</td>
                        <td>
                            <div>@row.AdmissionNumber</div>
                            <small class="text-muted">Roll: @(row.RollNumber ?? "-")</small>
                        </td>
                        <td class="text-center">@row.MarkedDays</td>
                        <td class="text-center">@row.PresentDays</td>
                        <td class="text-center">@row.AbsentDays</td>
                        <td class="text-center">@row.LateDays</td>
                        <td class="text-center">@row.LeaveDays</td>
                        <td class="text-center">@row.HalfDays</td>
                        <td class="text-end fw-semibold">
                            @row.AttendancePercentage.ToString("0.00")%
                            @if (row.IsLowAttendance)
                            {
                                <span class="badge text-bg-warning ms-1">Low</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="small text-muted mt-2">
        Formula used in M06: Present + Late count as 1 attended day, Half Day counts as 0.5, Absent/Leave count as 0, and Holiday/No Class are excluded from countable days.
    </div>
}
