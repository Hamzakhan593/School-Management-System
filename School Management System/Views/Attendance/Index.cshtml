@model School_Management_System.ViewModels.AttendanceMarkingViewModel
@using School_Management_System.Models
@{
    ViewData["Title"] = "Student Attendance";
}

<style>[data-attendance-row][hidden], #undoAttendanceBulk[hidden], #attendanceSelectionChanged[hidden] { display: none !important; }</style>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="mb-1">Student Attendance</h2>
        <div class="text-muted">Choose the class and date, mark students, then save attendance.</div>
    </div>
    <a class="btn btn-outline-primary" asp-action="MonthlyReport"
       asp-route-academicSessionId="@Model.AcademicSessionId"
       asp-route-schoolClassId="@(Model.SchoolClassId > 0 ? Model.SchoolClassId : null)"
       asp-route-sectionId="@Model.SectionId">Monthly Report</a>
</div>

<link rel="stylesheet" href="~/css/module-cards.css" asp-append-version="true" />
<details class="workspace-subsection attendance-tools">
    <summary>Camera, biometric &amp; attendance reports</summary>
    <div class="attendance-methods">
        <article class="attendance-method">
            <span class="attendance-method-tag">Daily attendance</span>
            <h3>Mark a class</h3>
            <p>Choose a class and date, then mark students in the list below.</p>
            <div class="attendance-method-actions"><a class="btn btn-primary" href="#attendanceFilters">Mark attendance</a></div>
        </article>
        <article class="attendance-method">
            <span class="attendance-method-tag">Camera</span>
            <h3>Camera attendance</h3>
            <p>Open the camera to record attendance and review student matches.</p>
            <div class="attendance-method-actions">
                <a class="btn btn-outline-primary" asp-controller="CameraAttendance" asp-action="Index">Open camera</a>
                @if (User.IsInRole(AppRoles.SuperAdmin) || User.IsInRole(AppRoles.Principal) || User.IsInRole(AppRoles.Admin))
                {
                    <a class="btn btn-outline-secondary" asp-controller="CameraAttendance" asp-action="Enroll">Enroll student faces</a>
                }
            </div>
        </article>
        <article class="attendance-method">
            <span class="attendance-method-tag">Fingerprint / device</span>
            <h3>Biometric attendance</h3>
            <p>Set up attendance devices, enroll students and check recorded scans.</p>
            <div class="attendance-method-actions">
                @if (User.IsInRole(AppRoles.SuperAdmin) || User.IsInRole(AppRoles.Principal) || User.IsInRole(AppRoles.Admin))
                {
                    <a class="btn btn-outline-primary" asp-controller="AttendanceIntegrations" asp-action="Index">Manage devices &amp; scans</a>
                }
                else
                {
                    <span class="text-muted small">Ask your school administrator to manage devices.</span>
                }
            </div>
        </article>
        <article class="attendance-method">
            <span class="attendance-method-tag">Reports</span>
            <h3>Monthly attendance</h3>
            <p>Review attendance percentages, absences and the monthly class register.</p>
            <div class="attendance-method-actions"><a class="btn btn-outline-primary" asp-controller="Attendance" asp-action="MonthlyReport"
                asp-route-academicSessionId="@Model.AcademicSessionId"
                asp-route-schoolClassId="@(Model.SchoolClassId > 0 ? Model.SchoolClassId : null)"
                asp-route-sectionId="@Model.SectionId">View monthly report</a></div>
        </article>
    </div>
</details>
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form id="attendanceFilters" data-sections-url="@Url.Action("Sections")" method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-lg-3 col-md-6">
                <label class="form-label">School session</label>
                <select class="form-select" name="academicSessionId" required>
                    @foreach (var session in Model.Sessions)
                    {
                        <option value="@session.Id" selected="@(session.Id == Model.AcademicSessionId)">@session.Name</option>
                    }
                </select>
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label">Class</label>
                <select class="form-select" name="schoolClassId" required>
                    <option value="">-- Select class --</option>
                    @foreach (var schoolClass in Model.Classes)
                    {
                        <option value="@schoolClass.Id" selected="@(schoolClass.Id == Model.SchoolClassId)">@schoolClass.Name</option>
                    }
                </select>
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label">Section</label>
                <select class="form-select" name="sectionId">
                    <option value="">@(Model.Sections.Count > 0 ? "-- Select section --" : "No section")</option>
                    @foreach (var sec in Model.Sections)
                    {
                        <option value="@sec.Id" selected="@(sec.Id == Model.SectionId)">@sec.Name</option>
                    }
                </select>
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label">Date</label>
                <input class="form-control" type="date" name="attendanceDate" required value="@Model.AttendanceDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-lg-2 col-md-6">
                <button class="btn btn-primary w-100" type="submit">Show students</button>
            </div>
        </form>
        @if (Model.SchoolClassId > 0 && Model.Sections.Count > 0 && !Model.SectionId.HasValue)
        {
            <div class="form-text mt-2">Choose a section, then click Show students.</div>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.AccessMessage))
{
    <div class="alert @(Model.CanEdit || Model.Students.Count == 0 ? "alert-info" : "alert-warning")">@Model.AccessMessage</div>
}

@if (Model.Students.Count > 0)
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <strong>@Model.SelectedClassName</strong>
            @if (!string.IsNullOrWhiteSpace(Model.SelectedSectionName))
            {
                <span> / @Model.SelectedSectionName</span>
            }
            <span class="text-muted">— @Model.AttendanceDate.ToString("dd MMM yyyy") — @Model.Students.Count students</span>
        </div>
        @if (Model.CanEdit)
        {
            <div class="d-flex gap-2">
                <button type="button" id="markUnmarkedPresent" class="btn btn-sm btn-outline-success">Mark remaining Present</button>
                <button type="button" disabled="@(!Model.AllowedStatuses.Contains(StudentAttendanceStatus.NoClass))" id="markAllNoClass" class="btn btn-sm btn-outline-secondary">No class today</button><button type="button" id="undoAttendanceBulk" class="btn btn-sm btn-outline-secondary" hidden>Undo last bulk change</button>
            </div>
        }
    </div>

    <div id="attendanceSelectionChanged" class="alert alert-warning" hidden>Class, section or date changed. Click Show students to load that selection before saving.</div>
    <div class="d-flex flex-wrap gap-2 mb-3"><label for="rosterSearch" class="visually-hidden">Find a student in this class</label><input id="rosterSearch" class="form-control" type="search" style="max-width:350px" placeholder="Find student by name, admission or roll number" /><label for="rosterFilter" class="visually-hidden">Show attendance status</label><select id="rosterFilter" class="form-select" style="max-width:220px"><option value="">All students</option><option value="0">Unmarked only</option><option value="2">Absent only</option></select></div>
    <p id="rosterMatches" class="small text-muted" role="status"></p>
    <div id="attendanceProgress" class="workspace-roster-status" aria-live="polite"></div>
    <form id="attendanceForm" method="post" asp-action="Save">
        <div asp-validation-summary="All" class="text-danger"></div>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="AcademicSessionId" />
        <input type="hidden" asp-for="SchoolClassId" />
        <input type="hidden" asp-for="SectionId" />
        <input type="hidden" asp-for="AttendanceDate" value="@Model.AttendanceDate.ToString("yyyy-MM-dd")" />

        @if (Model.RequiresCorrectionReason)
        {
            <div class="alert alert-warning">
                The normal teacher edit window has passed. This will be saved as an authorized late correction and recorded in the audit log.
            </div>
            <div class="mb-3">
                <label asp-for="CorrectionReason" class="form-label fw-semibold">Correction Reason</label>
                <textarea asp-for="CorrectionReason" class="form-control" rows="2" maxlength="500" required placeholder="Example: Teacher submitted wrong status; verified from class register."></textarea>
            </div>
        }

        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:70px">#</th>
                            <th>Student</th>
                            <th>Admission / Roll</th>
                            <th style="min-width:170px">Status</th>
                            <th style="min-width:240px">Remarks</th>
                            <th>Source</th>
                        </tr>
                    </thead>
                    <tbody>
                    @for (var i = 0; i < Model.Students.Count; i++)
                    {
                        <tr data-attendance-row>
                            <td>@(i + 1)</td>
                            <td>
                                <div class="fw-semibold">@Model.Students[i].StudentName</div>
                                @if (Model.Students[i].AlreadySaved)
                                {
                                    <span class="badge text-bg-light border">Saved</span>
                                }
                                <input type="hidden" asp-for="Students[i].StudentId" />
                                <input type="hidden" asp-for="Students[i].StudentEnrollmentId" />
                                <input type="hidden" asp-for="Students[i].StudentName" />
                            </td>
                            <td>
                                <div>@Model.Students[i].AdmissionNumber</div>
                                <small class="text-muted">Roll: @(Model.Students[i].RollNumber ?? "-")</small>
                            </td>
                            <td>
                                <select asp-for="Students[i].Status" aria-label="Attendance for @Model.Students[i].StudentName" class="form-select attendance-status" disabled="@(!Model.CanEdit)">
                                    <option value="0">Unmarked — choose status</option>
                                    @foreach (var status in Model.AllowedStatuses)
                                    {
                                        if (Model.Students[i].Status == status)
                                        {
                                            <option value="@((int)status)" selected>@(status == StudentAttendanceStatus.NoClass ? "No class" : status == StudentAttendanceStatus.HalfDay ? "Half day" : status.ToString())</option>
                                        }
                                        else
                                        {
                                            <option value="@((int)status)">@(status == StudentAttendanceStatus.NoClass ? "No class" : status == StudentAttendanceStatus.HalfDay ? "Half day" : status.ToString())</option>
                                        }
                                    }
                                </select>
                                @if (!Model.CanEdit)
                                {
                                    <input type="hidden" asp-for="Students[i].Status" />
                                }
                            </td>
                            <td>
                                <input asp-for="Students[i].Remarks" class="form-control" maxlength="300" disabled="@(!Model.CanEdit)" placeholder="Optional" />
                                @if (!Model.CanEdit)
                                {
                                    <input type="hidden" asp-for="Students[i].Remarks" />
                                }
                            </td>
                            <td><span class="badge text-bg-secondary">@Model.Students[i].Source</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (Model.CanEdit)
            {
                <div class="card-footer bg-white d-flex flex-wrap gap-3 align-items-center justify-content-between">
                    <span id="attendanceSaveState" class="small" role="status">Changes are saved when you click Save attendance.</span><button type="submit" class="btn btn-primary px-4">Save attendance</button>
                </div>
            }
        </div>
    </form>
}
else if (Model.SchoolClassId > 0 && (Model.Sections.Count == 0 || Model.SectionId.HasValue) && string.IsNullOrWhiteSpace(Model.AccessMessage))
{
    <div class="alert alert-info">No students are enrolled in this class/section for the selected date.</div>
}

@section Scripts { <script src="~/js/attendance-marking.js" asp-append-version="true"></script> }
