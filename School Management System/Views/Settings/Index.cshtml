@model School_Management_System.ViewModels.SettingsPageViewModel
@{
    ViewData["Title"] = "School settings";
    var months = System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.MonthNames;
}

<div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3 mb-4">
    <div>
        <div class="sms-eyebrow">Administration / </div>
        <h1 class="h2 mb-1">School settings</h1>
        <p class="text-secondary mb-0">Choose a category, adjust the options you need, then save your changes.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-secondary" asp-controller="SchoolSetup" asp-action="Index">School Profile</a>
        <a class="btn btn-outline-secondary" asp-controller="AcademicSessions" asp-action="Index">Academic Sessions</a>
        <button class="btn btn-primary" type="submit" form="settingsForm">Save Settings</button>
    </div>
</div>

<link rel="stylesheet" href="~/css/settings.css" asp-append-version="true" />
<div class="settings-workspace">
<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-muted small text-uppercase fw-semibold">School</div><div class="h5 mt-2 mb-1">@Model.SchoolName</div><div class="text-secondary small">@(Model.ActiveSessionName ?? "No active session")</div></div></div></div>
    <div class="col-6 col-xl-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-muted small text-uppercase fw-semibold">Fee types</div><div class="display-6 fw-bold">@Model.FeeHeadCount</div><div class="text-secondary small">active fee types</div></div></div></div>
    <div class="col-6 col-xl-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-muted small text-uppercase fw-semibold">Grading</div><div class="display-6 fw-bold">@Model.GradingRuleCount</div><div class="text-secondary small">rules in active session</div></div></div></div>
    <div class="col-6 col-xl-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-muted small text-uppercase fw-semibold">Last updated</div><div class="h5 mt-2 mb-1">@(Model.LastUpdatedAtUtc.HasValue ? Model.LastUpdatedAtUtc.Value.ToLocalTime().ToString("dd MMM yyyy") : "Defaults")</div><div class="text-secondary small">@(Model.LastUpdatedBy ?? "Default settings")</div></div></div></div>
</div>

<form data-has-errors="@(!ViewData.ModelState.IsValid ? "true" : "false")" id="settingsForm" asp-action="Index" method="post" enctype="multipart/form-data">
    <input asp-for="Id" type="hidden" /><input asp-for="SelectedSection" type="hidden" />
    <div class="settings-search"><label for="settingsSearch" class="form-label fw-semibold">Find a setting</label><input id="settingsSearch" class="form-control" type="search" placeholder="Try due date, password, backup or signature" autocomplete="off" /><p id="settingsSearchStatus" class="small text-muted mb-0 mt-2" role="status">Search across all categories. Your edits stay in place when you switch categories.</p><div id="settingsSearchResults" class="settings-search-results" hidden></div></div>
    <div class="settings-layout">
    <ul class="nav nav-pills settings-nav" id="settingsTabs" role="tablist" aria-label="Settings categories">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#numbering" type="button">Numbers &amp; school time</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#fees" type="button">Fees &amp; challans</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#attendance" type="button">Attendance</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#print" type="button">Results &amp; printing</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#backup" type="button">Backup &amp; recovery</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#security" type="button">Login &amp; passwords</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#integrations" type="button">Messages &amp; devices</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#masterdata" type="button">School setup links</button></li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane show active" id="numbering">
            <div class="card border-0 shadow-sm"><div class="card-header bg-white border-0 pt-4 px-4"><h2 class="h5 mb-1">Student and fee numbers</h2><p class="text-secondary mb-0">New records use these formats; existing numbers are never rewritten.</p></div><div class="card-body p-4">
                <div class="settings-preview" id="numberExamples" aria-live="polite"></div>
                <div class="settings-fields">
                    <div class="col-md-4"><label asp-for="AdmissionNumberPrefix" class="form-label">Student number starts with</label><div class="form-text settings-help" id="help-AdmissionNumberPrefix">Letters shown at the start of new admission numbers, for example STD. Use letters, numbers or hyphens.</div><input asp-for="AdmissionNumberPrefix" aria-describedby="help-AdmissionNumberPrefix" class="form-control" /><span asp-validation-for="AdmissionNumberPrefix" class="text-danger small"></span></div>
                    <div class="col-md-4"><label asp-for="AdmissionNumberDigits" class="form-label">Digits in student numbers</label><div class="form-text settings-help" id="help-AdmissionNumberDigits">Use 3–8 digits. Four digits gives 0001, 0002 and so on.</div><input asp-for="AdmissionNumberDigits" aria-describedby="help-AdmissionNumberDigits" class="form-control" /><span asp-validation-for="AdmissionNumberDigits" class="text-danger small"></span></div>
                    <div class="col-md-4"><label asp-for="FiscalYearStartMonth" class="form-label">Financial year starts in</label><div class="form-text settings-help" id="help-FiscalYearStartMonth">Saved accounting-year preference. Number sequences currently use the calendar year.</div><span asp-validation-for="FiscalYearStartMonth" class="text-danger small"></span><select asp-for="FiscalYearStartMonth" aria-describedby="help-FiscalYearStartMonth" class="form-select">@for (var i = 1; i <= 12; i++) { <option value="@i">@months[i - 1]</option> }</select></div>
                    <div class="col-md-4"><label asp-for="ChallanNumberPrefix" class="form-label">Challan number starts with</label><div class="form-text settings-help" id="help-ChallanNumberPrefix">For example CH. Existing challan numbers stay unchanged.</div><input asp-for="ChallanNumberPrefix" aria-describedby="help-ChallanNumberPrefix" class="form-control" /><span asp-validation-for="ChallanNumberPrefix" class="text-danger small"></span></div>
                    <div class="col-md-4"><label asp-for="ReceiptNumberPrefix" class="form-label">Receipt number starts with</label><div class="form-text settings-help" id="help-ReceiptNumberPrefix">For example RC. Existing receipt numbers stay unchanged.</div><input asp-for="ReceiptNumberPrefix" aria-describedby="help-ReceiptNumberPrefix" class="form-control" /><span asp-validation-for="ReceiptNumberPrefix" class="text-danger small"></span></div>
                    <div class="col-md-4"><label asp-for="FinancialNumberDigits" class="form-label">Digits in challan and receipt numbers</label><div class="form-text settings-help" id="help-FinancialNumberDigits">Use 4–10 digits. Six digits gives 000001.</div><span asp-validation-for="FinancialNumberDigits" class="text-danger small"></span><input asp-for="FinancialNumberDigits" aria-describedby="help-FinancialNumberDigits" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="SchoolTimeZoneId" class="form-label">School time zone</label><div class="form-text settings-help" id="help-SchoolTimeZoneId">Used for scheduled jobs and fee dates. Pakistan: Asia/Karachi. Ask your administrator before changing this.</div><span asp-validation-for="SchoolTimeZoneId" class="text-danger small"></span><input list="schoolTimeZones" asp-for="SchoolTimeZoneId" aria-describedby="help-SchoolTimeZoneId" class="form-control" /></div>
                </div>
            </div></div>
        </div>

        <div class="tab-pane" id="fees">
            <div class="card border-0 shadow-sm"><div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-start gap-3"><div><h2 class="h5 mb-1">Fees & monthly challans</h2><p class="text-secondary mb-0">Set payment dates, late fees and automatic monthly challans.</p></div><a class="btn btn-sm btn-outline-primary" asp-controller="Fees" asp-action="Index">Open Fees Module</a></div><div class="card-body p-4">
                <div class="settings-fields">
                    <div class="col-md-4"><label asp-for="DefaultFeeDueDay" class="form-label">Fee payment due day</label><div class="form-text settings-help" id="help-DefaultFeeDueDay">Day of each month, from 1 to 28. For example 10 means fees are due on the 10th.</div><span asp-validation-for="DefaultFeeDueDay" class="text-danger small"></span><input asp-for="DefaultFeeDueDay" aria-describedby="help-DefaultFeeDueDay" class="form-control" /></div>
                    <div class="col-md-4"><label asp-for="LateFeeFixedAmount" class="form-label">Late fee amount (PKR)</label><div class="form-text settings-help" id="help-LateFeeFixedAmount">A fixed charge on an overdue challan. Set 0 for no late fee.</div><span asp-validation-for="LateFeeFixedAmount" class="text-danger small"></span><div class="input-group"><span class="input-group-text">Rs.</span><input step="0.01" asp-for="LateFeeFixedAmount" aria-describedby="help-LateFeeFixedAmount" class="form-control" /></div></div>
                    <div class="col-md-4"><label asp-for="LateFeeGraceDays" class="form-label">Extra days before late fee</label><div class="form-text settings-help" id="help-LateFeeGraceDays">Days allowed after the due date before the late fee applies. Use 0 for no extra days.</div><span asp-validation-for="LateFeeGraceDays" class="text-danger small"></span><input asp-for="LateFeeGraceDays" aria-describedby="help-LateFeeGraceDays" class="form-control" /></div>
                    <div class="col-md-6"><div class="form-check form-switch mt-3"><input asp-for="ApplyLateFeeOnCollection" aria-describedby="help-ApplyLateFeeOnCollection" class="form-check-input" /><label asp-for="ApplyLateFeeOnCollection" class="form-check-label">Add late fees automatically</label><div class="form-text settings-help" id="help-ApplyLateFeeOnCollection">When on, eligible overdue challans receive the fixed late fee. Previously applied charges remain on saved challans.</div><span asp-validation-for="ApplyLateFeeOnCollection" class="text-danger small"></span></div></div>
                    <div class="col-md-6"><div class="form-check form-switch mt-3"><input asp-for="AutoGenerateMonthlyChallans" aria-describedby="help-AutoGenerateMonthlyChallans" class="form-check-input" /><label asp-for="AutoGenerateMonthlyChallans" class="form-check-label">Create monthly challans automatically</label><div class="form-text settings-help" id="help-AutoGenerateMonthlyChallans">Prepares challans for active sessions from the chosen day. The application must be running.</div><span asp-validation-for="AutoGenerateMonthlyChallans" class="text-danger small"></span></div></div>
                    <div class="col-md-4"><label asp-for="MonthlyChallanGenerationDay" class="form-label">Create challans on day</label><div class="form-text settings-help" id="help-MonthlyChallanGenerationDay">Day of the month, from 1 to 28. Used only when automatic generation is on.</div><span asp-validation-for="MonthlyChallanGenerationDay" class="text-danger small"></span><input asp-for="MonthlyChallanGenerationDay" aria-describedby="help-MonthlyChallanGenerationDay" class="form-control" /></div>
                </div>
                <div class="settings-preview mt-3" id="feeRuleSummary" aria-live="polite"></div><div class="alert alert-light border mt-4 mb-0"><strong>Set fee amounts:</strong> <a href="@Url.Action("Structures", "Fees")">Class / student fees</a> · <a href="@Url.Action("Discounts", "Fees")">Student discounts</a> · <a href="@Url.Action("FeeHeads", "Fees")">Fee types</a></div>
            </div></div>
        </div>

        <div class="tab-pane" id="attendance">
            <div class="card border-0 shadow-sm"><div class="card-header bg-white border-0 pt-4 px-4"><h2 class="h5 mb-1">Attendance options</h2><p class="text-secondary mb-0">Decide how long teachers can make corrections and which attendance choices they can use.</p></div><div class="card-body p-4">
                <div class="settings-fields">
                    <div class="col-md-6"><label asp-for="TeacherAttendanceEditCutoffHours" class="form-label">Teacher correction time (hours)</label><div class="form-text settings-help" id="help-TeacherAttendanceEditCutoffHours">Hours after the attendance day ends. After this window, a principal or admin must give a reason for corrections.</div><span asp-validation-for="TeacherAttendanceEditCutoffHours" class="text-danger small"></span><input asp-for="TeacherAttendanceEditCutoffHours" aria-describedby="help-TeacherAttendanceEditCutoffHours" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="LowAttendanceThresholdPercent" class="form-label">Flag attendance below (%)</label><div class="form-text settings-help" id="help-LowAttendanceThresholdPercent">Students below this percentage appear as low attendance in reports.</div><span asp-validation-for="LowAttendanceThresholdPercent" class="text-danger small"></span><div class="input-group"><input step="0.01" asp-for="LowAttendanceThresholdPercent" aria-describedby="help-LowAttendanceThresholdPercent" class="form-control" /><span class="input-group-text">%</span></div></div>

                    <div class="col-sm-6 col-lg-3"><div class="form-check form-switch"><input asp-for="AttendanceAllowLate" aria-describedby="help-AttendanceAllowLate" class="form-check-input" /><label asp-for="AttendanceAllowLate" class="form-check-label">Allow “Late”</label><div class="form-text settings-help" id="help-AttendanceAllowLate">Teachers can record students who arrive late.</div><span asp-validation-for="AttendanceAllowLate" class="text-danger small"></span></div></div>
                    <div class="col-sm-6 col-lg-3"><div class="form-check form-switch"><input asp-for="AttendanceAllowLeave" aria-describedby="help-AttendanceAllowLeave" class="form-check-input" /><label asp-for="AttendanceAllowLeave" class="form-check-label">Allow “Leave”</label><div class="form-text settings-help" id="help-AttendanceAllowLeave">Teachers can record an approved leave.</div><span asp-validation-for="AttendanceAllowLeave" class="text-danger small"></span></div></div>
                    <div class="col-sm-6 col-lg-3"><div class="form-check form-switch"><input asp-for="AttendanceAllowHalfDay" aria-describedby="help-AttendanceAllowHalfDay" class="form-check-input" /><label asp-for="AttendanceAllowHalfDay" class="form-check-label">Allow “Half day”</label><div class="form-text settings-help" id="help-AttendanceAllowHalfDay">Teachers can record a student attending part of a day.</div><span asp-validation-for="AttendanceAllowHalfDay" class="text-danger small"></span></div></div>
                    <div class="col-sm-6 col-lg-3"><div class="form-check form-switch"><input asp-for="AttendanceAllowNoClass" aria-describedby="help-AttendanceAllowNoClass" class="form-check-input" /><label asp-for="AttendanceAllowNoClass" class="form-check-label">Allow “No class”</label><div class="form-text settings-help" id="help-AttendanceAllowNoClass">Use when no class took place. Present and Absent remain available.</div><span asp-validation-for="AttendanceAllowNoClass" class="text-danger small"></span></div></div>
                </div>
            </div></div>
        </div>

        <div class="tab-pane" id="print">
            <div class="settings-print-layout">
                <div class="col-xl-8"><div class="card border-0 shadow-sm"><div class="card-header bg-white border-0 pt-4 px-4"><h2 class="h5 mb-1">Results and printed documents</h2><p class="text-secondary mb-0">Choose what appears on result cards and printed documents. Change the school logo in School Profile.</p></div><div class="card-body p-4">
                    <div class="settings-fields">
                        <div class="col-md-6"><div class="form-check form-switch"><input asp-for="ResultCardShowAttendance" aria-describedby="help-ResultCardShowAttendance" class="form-check-input" /><label asp-for="ResultCardShowAttendance" class="form-check-label">Show attendance on result cards</label><div class="form-text settings-help" id="help-ResultCardShowAttendance">Include the student’s attendance summary on their result card.</div><span asp-validation-for="ResultCardShowAttendance" class="text-danger small"></span></div></div>
                        <div class="col-md-6"><div class="form-check form-switch"><input asp-for="ResultCardShowClassPosition" aria-describedby="help-ResultCardShowClassPosition" class="form-check-input" /><label asp-for="ResultCardShowClassPosition" class="form-check-label">Show class position on result cards</label><div class="form-text settings-help" id="help-ResultCardShowClassPosition">Include the student’s position within the class.</div><span asp-validation-for="ResultCardShowClassPosition" class="text-danger small"></span></div></div>
                        <div class="col-md-6"><label asp-for="ClassTeacherSignatureLabel" class="form-label">Text below teacher signature</label><div class="form-text settings-help" id="help-ClassTeacherSignatureLabel">For example Class Teacher Signature.</div><span asp-validation-for="ClassTeacherSignatureLabel" class="text-danger small"></span><input asp-for="ClassTeacherSignatureLabel" aria-describedby="help-ClassTeacherSignatureLabel" class="form-control" /></div>
                        <div class="col-md-6"><label asp-for="PrincipalSignatureLabel" class="form-label">Text below principal signature</label><div class="form-text settings-help" id="help-PrincipalSignatureLabel">For example Principal Signature.</div><span asp-validation-for="PrincipalSignatureLabel" class="text-danger small"></span><input asp-for="PrincipalSignatureLabel" aria-describedby="help-PrincipalSignatureLabel" class="form-control" /></div>
                        <div class="col-12"><label asp-for="ResultCardFooterText" class="form-label">Message at bottom of result card</label><div class="form-text settings-help" id="help-ResultCardFooterText">A short note to parents, such as the date of the next term. Up to 500 characters.</div><span asp-validation-for="ResultCardFooterText" class="text-danger small"></span><textarea asp-for="ResultCardFooterText" aria-describedby="help-ResultCardFooterText" class="form-control" rows="2"></textarea></div>
                        <div class="col-md-6"><label asp-for="PayslipFooterText" class="form-label">Message at bottom of payslip</label><div class="form-text settings-help" id="help-PayslipFooterText">A short note on staff salary slips. Up to 500 characters.</div><span asp-validation-for="PayslipFooterText" class="text-danger small"></span><textarea asp-for="PayslipFooterText" aria-describedby="help-PayslipFooterText" class="form-control" rows="2"></textarea></div>
                        <div class="col-md-6"><label asp-for="GeneralPrintFooterText" class="form-label">Additional print message</label><div class="form-text settings-help" id="help-GeneralPrintFooterText">Additional footer text used by supported printed reports. Up to 500 characters.</div><span asp-validation-for="GeneralPrintFooterText" class="text-danger small"></span><textarea asp-for="GeneralPrintFooterText" aria-describedby="help-GeneralPrintFooterText" class="form-control" rows="2"></textarea></div>
                    </div>
                </div></div></div>
                <div class="col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-header bg-white border-0 pt-4 px-4"><h2 class="h5 mb-1">Saved signature images</h2><p class="text-secondary mb-0">PNG/JPG/WEBP, max 2 MB. Current result PDFs use signature lines; uploaded images are stored here for reference.</p></div><div class="card-body p-4">
                    <label asp-for="PrincipalSignatureFile" class="form-label">Upload principal signature</label><div class="form-text settings-help" id="help-PrincipalSignatureFile">PNG, JPG or WEBP, up to 2 MB. Leave empty to keep the saved image. Re-select the file if validation fails.</div><span asp-validation-for="PrincipalSignatureFile" class="text-danger small"></span><input asp-for="PrincipalSignatureFile" aria-describedby="help-PrincipalSignatureFile" class="form-control mb-2" accept="image/png,image/jpeg,image/webp" />
                    @if (!string.IsNullOrWhiteSpace(Model.PrincipalSignaturePath)) { <div class="border rounded p-2 mb-3 text-center"><img src="@Model.PrincipalSignaturePath" alt="Principal signature" style="max-height:65px;max-width:100%" /></div> }
                    <label asp-for="ClassTeacherSignatureFile" class="form-label">Upload class teacher signature</label><div class="form-text settings-help" id="help-ClassTeacherSignatureFile">PNG, JPG or WEBP, up to 2 MB. Leave empty to keep the saved image. Re-select the file if validation fails.</div><span asp-validation-for="ClassTeacherSignatureFile" class="text-danger small"></span><input asp-for="ClassTeacherSignatureFile" aria-describedby="help-ClassTeacherSignatureFile" class="form-control mb-2" accept="image/png,image/jpeg,image/webp" />
                    @if (!string.IsNullOrWhiteSpace(Model.ClassTeacherSignaturePath)) { <div class="border rounded p-2 text-center"><img src="@Model.ClassTeacherSignaturePath" alt="Class teacher signature" style="max-height:65px;max-width:100%" /></div> }
                </div></div></div>
            </div>
        </div>

        <div class="tab-pane" id="backup">
            <div class="card border-0 shadow-sm"><div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between gap-3"><div><h2 class="h5 mb-1">Keep a backup of school records</h2><p class="text-secondary mb-0">Choose the backup schedule and how long backups are kept.</p></div><a class="btn btn-sm btn-outline-primary align-self-start" asp-controller="Backup" asp-action="Index">Open Backup Center</a></div><div class="card-body p-4"><div class="settings-fields">
                <div class="col-md-4"><div class="form-check form-switch mt-4"><input asp-for="ScheduledBackupsEnabled" aria-describedby="help-ScheduledBackupsEnabled" class="form-check-input" /><label asp-for="ScheduledBackupsEnabled" class="form-check-label">Make backups automatically</label><div class="form-text settings-help" id="help-ScheduledBackupsEnabled">Uses the backup time below while the application is running. Check Backup Center for completed backups.</div><span asp-validation-for="ScheduledBackupsEnabled" class="text-danger small"></span></div></div>
                <div class="col-md-4"><label asp-for="BackupHourLocal" class="form-label">Daily backup time</label><div class="form-text settings-help" id="help-BackupHourLocal">Uses your school time zone. Choose a quiet time, for example 2:00 AM.</div><span asp-validation-for="BackupHourLocal" class="text-danger small"></span><select asp-for="BackupHourLocal" aria-describedby="help-BackupHourLocal" class="form-select">@for(var hour = 0; hour < 24; hour++) { <option value="@hour">@(new DateTime(2000, 1, 1, hour, 0, 0).ToString("h:mm tt", System.Globalization.CultureInfo.InvariantCulture))</option> }</select></div>
                <div class="col-md-4"><label asp-for="BackupRetentionDays" class="form-label">Keep backups for (days)</label><div class="form-text settings-help" id="help-BackupRetentionDays">Older backups can be removed after this period. Use 1–3650 days.</div><span asp-validation-for="BackupRetentionDays" class="text-danger small"></span><input asp-for="BackupRetentionDays" aria-describedby="help-BackupRetentionDays" class="form-control" /></div>
                <div class="col-12"><div class="form-check form-switch"><input asp-for="AllowInAppRestore" aria-describedby="help-AllowInAppRestore" class="form-check-input" /><label asp-for="AllowInAppRestore" class="form-check-label">Allow restoring a backup in the app</label><div class="form-text settings-help" id="help-AllowInAppRestore">Authorized staff can replace current data with a backup. Backup Center still requires a password, reason and confirmation.</div><span asp-validation-for="AllowInAppRestore" class="text-danger small"></span></div></div>
            </div></div></div>
        </div>

        <div class="tab-pane" id="security">
            <div class="card border-0 shadow-sm"><div class="card-header bg-white border-0 pt-4 px-4"><h2 class="h5 mb-1">Login and password rules</h2><p class="text-secondary mb-0">Password rules apply when passwords are created or changed. Set when inactive users must log in again.</p></div><div class="card-body p-4"><div class="settings-fields">
                <div class="col-md-6"><label asp-for="SessionTimeoutMinutes" class="form-label">Log out inactive users after (minutes)</label><div class="form-text settings-help" id="help-SessionTimeoutMinutes">A user who stops using the app must log in again after 5–720 minutes.</div><span asp-validation-for="SessionTimeoutMinutes" class="text-danger small"></span><input asp-for="SessionTimeoutMinutes" aria-describedby="help-SessionTimeoutMinutes" class="form-control" /></div>
                <div class="col-md-6"><label asp-for="PasswordRequiredLength" class="form-label">Minimum password characters</label><div class="form-text settings-help" id="help-PasswordRequiredLength">New or changed passwords must contain at least this many characters. Use 6–32.</div><span asp-validation-for="PasswordRequiredLength" class="text-danger small"></span><input asp-for="PasswordRequiredLength" aria-describedby="help-PasswordRequiredLength" class="form-control" /></div>
                <div class="col-sm-6 col-lg-3"><div class="form-check form-switch"><input asp-for="PasswordRequireDigit" aria-describedby="help-PasswordRequireDigit" class="form-check-input" /><label asp-for="PasswordRequireDigit" class="form-check-label">Include a number</label><div class="form-text settings-help" id="help-PasswordRequireDigit">Require at least one digit, such as 3 or 8.</div><span asp-validation-for="PasswordRequireDigit" class="text-danger small"></span></div></div>
                <div class="col-sm-6 col-lg-3"><div class="form-check form-switch"><input asp-for="PasswordRequireUppercase" aria-describedby="help-PasswordRequireUppercase" class="form-check-input" /><label asp-for="PasswordRequireUppercase" class="form-check-label">Include a capital letter</label><div class="form-text settings-help" id="help-PasswordRequireUppercase">Require at least one letter such as A or B.</div><span asp-validation-for="PasswordRequireUppercase" class="text-danger small"></span></div></div>
                <div class="col-sm-6 col-lg-3"><div class="form-check form-switch"><input asp-for="PasswordRequireLowercase" aria-describedby="help-PasswordRequireLowercase" class="form-check-input" /><label asp-for="PasswordRequireLowercase" class="form-check-label">Include a small letter</label><div class="form-text settings-help" id="help-PasswordRequireLowercase">Require at least one letter such as a or b.</div><span asp-validation-for="PasswordRequireLowercase" class="text-danger small"></span></div></div>
                <div class="col-sm-6 col-lg-3"><div class="form-check form-switch"><input asp-for="PasswordRequireSpecialCharacter" aria-describedby="help-PasswordRequireSpecialCharacter" class="form-check-input" /><label asp-for="PasswordRequireSpecialCharacter" class="form-check-label">Include a symbol</label><div class="form-text settings-help" id="help-PasswordRequireSpecialCharacter">Require at least one symbol such as ! or #.</div><span asp-validation-for="PasswordRequireSpecialCharacter" class="text-danger small"></span></div></div>
            </div></div></div>
        </div>

        <div class="tab-pane" id="integrations">
            <div class="settings-print-layout">
                <div class="col-xl-7"><div class="card border-0 shadow-sm h-100"><div class="card-header bg-white border-0 pt-4 px-4"><h2 class="h5 mb-1">Email, SMS and WhatsApp</h2><p class="text-secondary mb-0">Email, SMS and WhatsApp delivery is not connected in this version. These preferences can be saved now; a technical administrator must implement and connect delivery before messages can be sent.</p></div><div class="card-body p-4"><div class="settings-fields">
                    <div class="col-md-4"><div class="form-check form-switch mb-2"><input asp-for="EmailNotificationsEnabled" aria-describedby="help-EmailNotificationsEnabled" class="form-check-input" /><label asp-for="EmailNotificationsEnabled" class="form-check-label">Allow email messages</label><div class="form-text settings-help" id="help-EmailNotificationsEnabled">Your email service must also be connected on the server.</div><span asp-validation-for="EmailNotificationsEnabled" class="text-danger small"></span></div><label asp-for="EmailProviderName" class="form-label">Email service name</label><div class="form-text settings-help" id="help-EmailProviderName">Name of the configured email service. Do not enter passwords or API keys here.</div><span asp-validation-for="EmailProviderName" class="text-danger small"></span><input asp-for="EmailProviderName" aria-describedby="help-EmailProviderName" class="form-control" placeholder="e.g. SMTP / SendGrid" /></div>
                    <div class="col-md-4"><div class="form-check form-switch mb-2"><input asp-for="SmsNotificationsEnabled" aria-describedby="help-SmsNotificationsEnabled" class="form-check-input" /><label asp-for="SmsNotificationsEnabled" class="form-check-label">Allow SMS messages</label><div class="form-text settings-help" id="help-SmsNotificationsEnabled">Your SMS service must also be connected on the server.</div><span asp-validation-for="SmsNotificationsEnabled" class="text-danger small"></span></div><label asp-for="SmsProviderName" class="form-label">SMS service name</label><div class="form-text settings-help" id="help-SmsProviderName">Name of the configured SMS service. Your technical administrator can provide it.</div><span asp-validation-for="SmsProviderName" class="text-danger small"></span><input asp-for="SmsProviderName" aria-describedby="help-SmsProviderName" class="form-control" placeholder="SMS provider" /></div>
                    <div class="col-md-4"><div class="form-check form-switch mb-2"><input asp-for="WhatsAppNotificationsEnabled" aria-describedby="help-WhatsAppNotificationsEnabled" class="form-check-input" /><label asp-for="WhatsAppNotificationsEnabled" class="form-check-label">Allow WhatsApp messages</label><div class="form-text settings-help" id="help-WhatsAppNotificationsEnabled">Your WhatsApp service must also be connected on the server.</div><span asp-validation-for="WhatsAppNotificationsEnabled" class="text-danger small"></span></div><label asp-for="WhatsAppProviderName" class="form-label">WhatsApp service name</label><div class="form-text settings-help" id="help-WhatsAppProviderName">Name of the configured WhatsApp service. Your technical administrator can provide it.</div><span asp-validation-for="WhatsAppProviderName" class="text-danger small"></span><input asp-for="WhatsAppProviderName" aria-describedby="help-WhatsAppProviderName" class="form-control" placeholder="WhatsApp provider" /></div>
                </div></div></div></div>
                <div class="col-xl-5"><div class="card border-0 shadow-sm h-100"><div class="card-header bg-white border-0 pt-4 px-4"><h2 class="h5 mb-1">Devices and additional features</h2><p class="text-secondary mb-0">These saved preferences do not currently enable or block module access. Devices still require their own setup. Portal, payment and push delivery features are not activated here.</p></div><div class="card-body p-4 d-grid gap-3">
                    <div class="form-check form-switch"><input asp-for="EnableBiometricAttendance" aria-describedby="help-EnableBiometricAttendance" class="form-check-input" /><label asp-for="EnableBiometricAttendance" class="form-check-label">Fingerprint / biometric preference</label><div class="form-text settings-help" id="help-EnableBiometricAttendance">Requires a configured device and student device enrollment.</div><span asp-validation-for="EnableBiometricAttendance" class="text-danger small"></span></div>
                    <div class="form-check form-switch"><input asp-for="EnableCameraAttendance" aria-describedby="help-EnableCameraAttendance" class="form-check-input" /><label asp-for="EnableCameraAttendance" class="form-check-label">Camera attendance preference</label><div class="form-text settings-help" id="help-EnableCameraAttendance">Requires camera setup and student face enrollment.</div><span asp-validation-for="EnableCameraAttendance" class="text-danger small"></span></div>
                    <div class="form-check form-switch"><input asp-for="EnableParentStudentPortal" aria-describedby="help-EnableParentStudentPortal" class="form-check-input" /><label asp-for="EnableParentStudentPortal" class="form-check-label">Parent / student portal preference</label><div class="form-text settings-help" id="help-EnableParentStudentPortal">Future feature preference only. Saving this does not create or activate a portal.</div><span asp-validation-for="EnableParentStudentPortal" class="text-danger small"></span></div>
                    <div class="form-check form-switch"><input asp-for="EnableOnlinePayments" aria-describedby="help-EnableOnlinePayments" class="form-check-input" /><label asp-for="EnableOnlinePayments" class="form-check-label">Online payments preference</label><div class="form-text settings-help" id="help-EnableOnlinePayments">Future feature preference only. Saving this does not connect a payment gateway.</div><span asp-validation-for="EnableOnlinePayments" class="text-danger small"></span></div>
                    <div class="form-check form-switch"><input asp-for="EnablePushNotifications" aria-describedby="help-EnablePushNotifications" class="form-check-input" /><label asp-for="EnablePushNotifications" class="form-check-label">Push notifications preference</label><div class="form-text settings-help" id="help-EnablePushNotifications">Future feature preference only. Saving this does not activate push delivery.</div><span asp-validation-for="EnablePushNotifications" class="text-danger small"></span></div>
                </div></div></div>
            </div>
        </div>

        <div class="tab-pane" id="masterdata">
            <div class="settings-fields">
                <div class="col-md-6 col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-body p-4"><h3 class="h5">Classes &amp; sections</h3><p class="text-secondary">Set up the classes and sections used in admissions, attendance and fees.</p><a asp-controller="AcademicStructure" asp-action="Index" class="btn btn-outline-primary">Manage classes</a></div></div></div>
                <div class="col-md-6 col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-body p-4"><h3 class="h5">School sessions &amp; terms</h3><p class="text-secondary">Set school-year dates, terms and holidays, or activate the next session.</p><a asp-controller="AcademicSessions" asp-action="Index" class="btn btn-outline-primary">Manage sessions</a></div></div></div>

                <div class="col-md-6 col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-body p-4"><div class="text-muted small text-uppercase fw-semibold">School identity</div><h3 class="h5 mt-2">Logo & Document Footers</h3><p class="text-secondary">School logo, challan footer and receipt footer are already centralized in the School Profile.</p><a asp-controller="SchoolSetup" asp-action="Index" class="btn btn-outline-primary">Manage School Profile</a></div></div></div>
                <div class="col-md-6 col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-body p-4"><div class="text-muted small text-uppercase fw-semibold">School fees</div><h3 class="h5 mt-2">Fee types and discounts</h3><p class="text-secondary">Set fee types, class fees and discounts for individual students.</p><a asp-controller="Fees" asp-action="Index" class="btn btn-outline-primary">Open fee setup</a></div></div></div>
                <div class="col-md-6 col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-body p-4"><div class="text-muted small text-uppercase fw-semibold">School academics</div><h3 class="h5 mt-2">Grading Scheme</h3><p class="text-secondary">Grading schemes remain academic-session specific so historical result cards are not silently rewritten.</p><a asp-controller="AcademicSessions" asp-action="Index" class="btn btn-outline-primary">Manage Grading</a></div></div></div>
            </div>
        </div>
    </div>

    </div>
    <div class="settings-savebar"><div><strong id="settingsSaveState" role="status">No unsaved changes</strong><div class="small text-muted">Save applies your edits across all categories.</div></div><button class="btn btn-primary px-4" type="submit">Save all changes</button></div>
</form>
<datalist id="schoolTimeZones"><option value="Asia/Karachi">Pakistan</option><option value="Asia/Bangkok">Thailand</option><option value="Asia/Dubai">United Arab Emirates</option><option value="UTC">UTC</option></datalist>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/settings.js" asp-append-version="true"></script>
}
