@model School_Management_System.ViewModels.StudentIndexViewModel
@{
    ViewData["Title"] = "Students";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Students</h1>
        <p class="text-muted mb-0">Find a student, update their details, or open their class and guardian information.</p>
    </div>
    @if (User.IsInRole(AppRoles.SuperAdmin) || User.IsInRole(AppRoles.Principal) || User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Receptionist))
    {
        <a class="btn btn-primary" asp-controller="Admissions" asp-action="StartAdmission">Add student / new admission</a>
    }
</div>

<div class="row g-3 mb-4 student-summary">
    <div class="col-md-4"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted">Total Students</div><div class="display-6 fw-semibold">@Model.TotalStudents</div></div></div></div>
    <div class="col-md-4"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted">Active</div><div class="display-6 fw-semibold">@Model.ActiveStudents</div></div></div></div>
    <div class="col-md-4"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted">Inactive / other</div><div class="display-6 fw-semibold">@Model.InactiveStudents</div></div></div></div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-lg-4">
                <label class="form-label">Search</label>
                <input class="form-control" name="q" value="@Model.Query" placeholder="Student name or number" aria-describedby="studentSearchHelp" /><div id="studentSearchHelp" class="form-text">Name, admission number, roll number or guardian phone.</div>
            </div>
            <div class="col-md-3 col-lg-2">
                <label class="form-label">Status</label>
                <select class="form-select" name="status">
                    <option value="">All</option>
                    @foreach (var item in Enum.GetValues<StudentStatus>())
                    {
                        <option value="@item" selected="@(Model.Status == item)">@item</option>
                    }
                </select>
            </div>
            <div class="col-md-3 col-lg-2">
                <label class="form-label">Class</label>
                <select class="form-select" name="className">
                    <option value="">All</option>
                    @foreach (var cls in Model.Classes)
                    {
                        <option value="@cls" selected="@(Model.ClassName == cls)">@cls</option>
                    }
                </select>
            </div>
            <div class="col-md-3 col-lg-2">
                <label class="form-label">Session</label>
                <select class="form-select" name="academicSessionId">
                    <option value="">All</option>
                    @foreach (var session in Model.Sessions)
                    {
                        <option value="@session.Id" selected="@(Model.AcademicSessionId == session.Id)">@session.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3 col-lg-2"><label for="sectionName" class="form-label">Section</label><select name="sectionName" id="sectionName" class="form-select"><option value="">All sections</option>@foreach (string sectionLabel in ViewBag.Sections) { <option value="@sectionLabel" selected="@(ViewBag.SectionName == sectionLabel)">@sectionLabel</option> }</select></div>
            <div class="col-md-3 col-lg-2 d-grid">
                <button class="btn btn-outline-primary" type="submit">Search Students</button>
            </div>
        <div class="col-auto"><a class="btn btn-link" asp-action="Index">Clear filters</a></div></form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Admission No.</th>
                        <th>Student</th>
                        <th>Class / Section</th>
                        <th>Roll No.</th>
                        <th>Guardian Phone</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Students.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-5">No students match these filters. Try a name or admission number, or clear the filters above.</td></tr>
                }
                else
                {
                    @foreach (var student in Model.Students)
                    {
                        var placement = student.Enrollments.FirstOrDefault(x => x.IsCurrent);
                        var guardian = student.StudentGuardians.OrderByDescending(x => x.IsPrimary).FirstOrDefault()?.Guardian;
                        <tr>
                            <td class="fw-semibold">@student.AdmissionNumber</td>
                            <td>
                                <a class="fw-semibold" asp-action="Details" asp-route-id="@student.Id">@student.FullName</a>
                                <small class="text-muted">@(student.BFormCnic ?? "No B-Form/CNIC")</small>
                            </td>
                            <td>
                                @if (placement is null)
                                {
                                    <span class="text-muted">Not assigned</span>
                                }
                                else
                                {
                                    <span>@placement.ClassName</span>
                                    @if (!string.IsNullOrWhiteSpace(placement.SectionName)) { <span> / @placement.SectionName</span> }
                                    <div><small class="text-muted">@placement.AcademicSession.Name</small></div>
                                }
                            </td>
                            <td>@(placement?.RollNumber ?? student.RollNumber ?? "—")</td>
                            <td>@(guardian?.Phone ?? "—")</td>
                            <td><span class="badge text-bg-@(student.Status == StudentStatus.Active ? "success" : "secondary")">@student.Status</span></td>
                            <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@student.Id">Open Profile</a></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>


<nav class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3" aria-label="Student pages">
<span class="text-muted small">@ViewBag.MatchCount matching students · Page @ViewBag.Page of @ViewBag.PageCount</span><div class="d-flex gap-2">
@if (ViewBag.Page > 1) { <a class="btn btn-outline-secondary" asp-action="Index" asp-route-page="@(ViewBag.Page - 1)" asp-route-q="@Model.Query" asp-route-status="@Model.Status" asp-route-className="@Model.ClassName" asp-route-sectionName="@ViewBag.SectionName" asp-route-academicSessionId="@Model.AcademicSessionId">Previous</a> }
@if (ViewBag.Page < ViewBag.PageCount) { <a class="btn btn-outline-primary" asp-action="Index" asp-route-page="@(ViewBag.Page + 1)" asp-route-q="@Model.Query" asp-route-status="@Model.Status" asp-route-className="@Model.ClassName" asp-route-sectionName="@ViewBag.SectionName" asp-route-academicSessionId="@Model.AcademicSessionId">Next</a> }
</div></nav>
