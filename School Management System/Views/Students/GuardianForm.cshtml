@model School_Management_System.ViewModels.StudentGuardianFormViewModel
@{
    var student = (Student)ViewBag.Student;
    ViewData["Title"] = Model.GuardianId == 0 ? "Add Guardian" : "Edit Guardian";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">@(Model.GuardianId == 0 ? "Add Guardian" : "Edit Guardian")</h1>
        <p class="text-muted mb-0">@student.FullName — @student.AdmissionNumber</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@student.Id">Back to Profile</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="SaveGuardian" method="post">
            <input type="hidden" asp-for="StudentId" />
            <input type="hidden" asp-for="GuardianId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Relationship" class="form-label"></label>
                    <input asp-for="Relationship" class="form-control" placeholder="Father / Mother / Guardian" />
                    <span asp-validation-for="Relationship" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Occupation" class="form-label"></label>
                    <input asp-for="Occupation" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Cnic" class="form-label"></label>
                    <input asp-for="Cnic" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Address" class="form-label"></label>
                    <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="IsPrimary" class="form-check-input" />
                        <label asp-for="IsPrimary" class="form-check-label"></label>
                    </div>
                </div>
            </div>
            <button class="btn btn-primary mt-4" type="submit">Save Guardian</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
