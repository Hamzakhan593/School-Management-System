@model School_Management_System.ViewModels.DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; var today = Model.GeneratedAt; var month = new DateTime(today.Year,today.Month,1).ToString("dd MMM") + " – " + new DateTime(today.Year,today.Month,1).AddMonths(1).AddDays(-1).ToString("dd MMM yyyy"); }
<section class="sms-page-head"><div><div class="sms-eyebrow">DAILY SCHOOL SUMMARY</div><h1>Your school at a glance</h1><p>@today.ToString("dddd, dd MMMM yyyy") · @Model.AcademicSessionName</p></div><div class="sms-head-actions">
@if (Model.ShowAdmissions) { <a class="btn btn-primary" asp-controller="Admissions" asp-action="CreateEnquiry">Add Student</a> }
@if (Model.ShowFinance) { <a class="btn @(Model.ShowAdmissions ? "btn-outline-primary" : "btn-primary")" asp-controller="Fees" asp-action="Index">Collect Fee</a> }
@if (Model.ShowAttendance) { <a class="btn @(Model.ShowAdmissions || Model.ShowFinance ? "btn-outline-primary" : "btn-primary")" asp-controller="Attendance" asp-action="Index">Mark Attendance</a> }
</div></section>
@if (!Model.HasSchoolContext) { <section class="sms-panel"><h2 class="h4">Set up your school</h2><p>Add the school profile and an academic session to get started.</p>@if(Model.ShowAudit){<a class="btn btn-primary" asp-controller="SchoolSetup" asp-action="Index">Set Up School</a>}</section> }
else if (!Model.ShowAdmissions && !Model.ShowFinance && !Model.ShowAttendance && !Model.ShowHr && !Model.ShowAcademics) { <section class="sms-panel"><h2 class="h4">School notices</h2><p>View updates and documents shared with your account.</p><a class="btn btn-primary" asp-controller="Communications" asp-action="Index">Open Notices</a></section> }
else {
<div class="sms-kpi-grid mb-4">
@if(Model.ShowAdmissions || Model.ShowAudit) { <article class="sms-kpi-card"><div class="sms-kpi-label">Active students</div><div class="sms-kpi-value">@Model.ActiveStudents.ToString("N0")</div><div class="sms-kpi-foot">Currently enrolled · @today.ToString("dd MMM yyyy")</div></article> }
@if(Model.ShowAttendance) { <article class="sms-kpi-card"><div class="sms-kpi-label">Today's attendance</div><div class="sms-kpi-value">@Model.TodayAttendancePercentage.ToString("0.#")<span class="fs-5">%</span></div><div class="sms-kpi-foot">Of marked attendance · @today.ToString("dd MMM")<br/><span class="text-warning">@Model.TodayUnmarked students unmarked</span></div></article> }
@if(Model.ShowFinance) { <article class="sms-kpi-card"><div class="sms-kpi-label">Fees collected this month</div><div class="sms-kpi-value sms-money">PKR @Model.CurrentMonthCollectedFees.ToString("N2")</div><div class="sms-kpi-foot">@month</div></article><article class="sms-kpi-card"><div class="sms-kpi-label">Outstanding fees</div><div class="sms-kpi-value sms-money">PKR @Model.OutstandingFees.ToString("N2")</div><div class="sms-kpi-foot">All periods · as of @today.ToString("dd MMM yyyy")</div></article> }
@if(Model.ShowAdmissions && !Model.ShowFinance) { <article class="sms-kpi-card"><div class="sms-kpi-label">Admissions awaiting review</div><div class="sms-kpi-value">@Model.PendingAdmissions</div><div class="sms-kpi-foot">Draft and submitted applications</div></article> }
@if(Model.ShowAcademics && !Model.ShowAdmissions) { <article class="sms-kpi-card"><div class="sms-kpi-label">Active exams</div><div class="sms-kpi-value">@Model.ActiveExams</div><div class="sms-kpi-foot">Current school exams</div></article> }
@if(Model.ShowHr && !Model.ShowFinance) { <article class="sms-kpi-card"><div class="sms-kpi-label">Active staff</div><div class="sms-kpi-value">@Model.ActiveStaff</div><div class="sms-kpi-foot">As of @today.ToString("dd MMM yyyy")</div></article> }
</div>
<div class="row g-4"><div class="col-xl-8">
@if(Model.ShowAttendance) { <section class="sms-panel mb-4"><div class="sms-panel-head"><div><div class="sms-panel-kicker">Daily register</div><h2>Attendance today</h2><p>@today.ToString("dd MMM yyyy") · @(Model.RoleName.StartsWith("Teacher") ? "Your assigned classes" : "Current session")</p></div><a class="sms-text-link" asp-controller="Attendance" asp-action="Index">Open attendance →</a></div><div class="workspace-attendance"><div><span>Present / half day</span><strong class="text-success">@Model.TodayPresent</strong></div><div><span>Absent</span><strong class="text-danger">@Model.TodayAbsent</strong></div><div><span>On leave</span><strong>@Model.TodayLeave</strong></div><div><span>Unmarked</span><strong class="text-warning">@Model.TodayUnmarked</strong></div></div><p class="small text-muted mt-3 mb-0">@Model.TodayLate late arrivals recorded. Unmarked students are never counted as present.</p></section> }
@if(Model.ShowFinance) { <section class="sms-panel mb-4"><div class="sms-panel-head"><div><div class="sms-panel-kicker">Fee follow-up</div><h2>Keep collections on track</h2><p>All unpaid billing periods · as of @today.ToString("dd MMM yyyy")</p></div></div><div class="row g-3"><div class="col-md-6"><div class="workspace-summary h-100"><span class="badge text-bg-warning mb-2">Due · not overdue</span><h3 class="fs-4">PKR @Math.Max(0,Model.OutstandingFees-Model.OverdueFees).ToString("N2")</h3><p class="small text-muted mb-0">Unpaid fees with due dates today or later.</p></div></div><div class="col-md-6"><div class="workspace-summary h-100"><span class="badge text-bg-danger mb-2">Overdue</span><h3 class="fs-4">PKR @Model.OverdueFees.ToString("N2")</h3><p class="small text-muted">@Model.FeeDefaulters students have fees past their due date.</p><a class="sms-text-link" asp-controller="Fees" asp-action="Defaulters">View overdue fees →</a></div></div></div></section> }
@if(Model.ShowAdmissions && !Model.ShowFinance) { <section class="sms-panel"><div class="sms-panel-head"><div><div class="sms-panel-kicker">Admissions</div><h2>Continue an application</h2><p>@Model.OpenEnquiries open enquiries · @Model.PendingAdmissions applications awaiting review</p></div></div><a class="btn btn-outline-primary" asp-controller="Admissions" asp-action="Applications">Review Applications</a></section> }
@if(Model.ShowAcademics && !Model.ShowAdmissions) { <section class="sms-panel"><div class="sms-panel-head"><div><div class="sms-panel-kicker">Teaching</div><h2>Classes & results</h2><p>Continue your academic work.</p></div></div><div class="d-flex gap-2"><a class="btn btn-outline-primary" asp-controller="Exams" asp-action="Index">Open Exams</a><a class="btn btn-outline-primary" asp-controller="Results" asp-action="Index">View Results</a></div></section> }
</div><div class="col-xl-4"><section class="sms-panel"><div class="sms-panel-head"><div><div class="sms-panel-kicker">Needs attention</div><h2>Your next steps</h2></div></div><div class="sms-alert-list">
@if(Model.ShowAttendance && Model.TodayUnmarked>0) { <a class="sms-alert-row warning" asp-controller="Attendance" asp-action="Index"><span class="sms-alert-dot"></span><span><strong>Complete today's attendance</strong><small>@Model.TodayUnmarked students still unmarked.</small></span></a> }
@foreach(var alert in Model.Alerts.Where(x => !x.Title.Contains("attendance", StringComparison.OrdinalIgnoreCase)).Take(4)) { @if(!string.IsNullOrWhiteSpace(alert.Controller)){<a class="sms-alert-row @alert.Tone" asp-controller="@alert.Controller" asp-action="@alert.Action"><span class="sms-alert-dot"></span><span><strong>@alert.Title</strong><small>@alert.Message</small></span><svg><use href="#i-chevron"></use></svg></a>}else{<div class="sms-alert-row"><span><strong>@alert.Title</strong><small>@alert.Message</small></span></div>} }
</div></section><section class="sms-panel mt-4"><div class="sms-panel-head"><div><div class="sms-panel-kicker">Shortcuts</div><h2>Everyday work</h2></div></div><div class="sms-quick-grid">
@if(Model.ShowAdmissions) { <a asp-controller="Students" asp-action="Index"><span><strong>Find a student →</strong><small>Profile, contacts and records</small></span></a> }
@if(Model.ShowFinance) { <a asp-controller="Fees" asp-action="DailyCollection"><span><strong>Today's collection →</strong><small>Review payments and receipts</small></span></a> }
<a asp-controller="Reports" asp-action="Index"><span><strong>Open reports →</strong><small>View and export school records</small></span></a></div></section></div></div>
}
