@model School_Management_System.ViewModels.PaymentEntryViewModel
@using School_Management_System.Models
@{ ViewData["Title"] = "Collect Fee"; }
<div class="sms-page-head"><div><div class="sms-eyebrow">Fees</div><h1>Collect Fee</h1><p>@Model.StudentName · @Model.AdmissionNumber</p></div><a class="btn btn-outline-secondary" asp-action="Ledger" asp-route-studentId="@Model.StudentId">Back to Student Fees</a></div>
<ol class="workspace-steps"><li>1 · Select student</li><li class="current">2 · Review & collect</li><li>3 · Print receipt</li></ol>
<div class="row g-4"><div class="col-lg-7"><section class="card"><div class="card-body p-lg-4"><h2 class="h5 mb-3">Payment details</h2>
@if (Model.Outstanding <= 0) { <div class="alert alert-success">No outstanding balance. This student's fees are paid.</div> }
else { <form asp-action="CollectPayment" method="post" data-payment-form data-outstanding="@Model.Outstanding.ToString(System.Globalization.CultureInfo.InvariantCulture)">
@Html.AntiForgeryToken()<input type="hidden" asp-for="StudentId"/><input type="hidden" asp-for="FromChallanId"/><input type="hidden" asp-for="RequestId"/>
<div asp-validation-summary="All" class="text-danger mb-3"></div>
<div class="mb-4"><label asp-for="Amount" class="form-label">Amount received</label><div class="input-group"><span class="input-group-text">PKR</span><input class="form-control" type="number" inputmode="decimal" step="0.01" min="0.01" max="@Model.Outstanding.ToString(System.Globalization.CultureInfo.InvariantCulture)" asp-for="Amount" required aria-describedby="amountHelp"/></div><span asp-validation-for="Amount" class="text-danger"></span><div class="form-text" id="amountHelp">Enter the amount actually received. Partial payments are allowed.</div></div>
<div class="mb-4"><label asp-for="PaymentMethod" class="form-label">Payment method</label><select class="form-select" asp-for="PaymentMethod" asp-items="Html.GetEnumSelectList<FeePaymentMethod>()"></select></div>
<div class="mb-4"><label asp-for="ReferenceNumber" class="form-label">Reference number <span class="text-muted fw-normal">· optional</span></label><input class="form-control" asp-for="ReferenceNumber" maxlength="150" placeholder="Bank transfer or cheque reference"/><span asp-validation-for="ReferenceNumber" class="text-danger"></span></div>
<details class="workspace-subsection"><summary>Add a note · optional</summary><label asp-for="Notes" class="form-label">Payment note</label><textarea class="form-control" rows="2" asp-for="Notes" maxlength="500"></textarea><span asp-validation-for="Notes" class="text-danger"></span></details>
<div class="workspace-actions"><a class="btn btn-outline-secondary" asp-action="Ledger" asp-route-studentId="@Model.StudentId">Cancel</a><button class="btn btn-primary px-4" type="submit">Collect Fee</button></div>
</form> }</div></section></div><div class="col-lg-5 order-first order-lg-last"><aside class="workspace-summary"><h3>Payment summary</h3><div class="text-muted small">All unpaid periods · as of @DateTime.Today.ToString("dd MMM yyyy")</div><dl><div><dt>Total payable</dt><dd>PKR @Model.Outstanding.ToString("N2")</dd></div><div><dt>Amount received</dt><dd id="receivedPreview">PKR @Model.Amount.ToString("N2")</dd></div><div><dt>Remaining balance</dt><dd id="remainingPreview">PKR @Math.Max(0, Model.Outstanding - Model.Amount).ToString("N2")</dd></div></dl><p id="partialNotice" class="small mt-3" aria-live="polite">Review the amount before saving.</p><p class="small text-muted mb-0">Payments clear the oldest unpaid challans first. A receipt is available after the payment is saved.</p><a class="btn btn-link ps-0 mt-2" asp-action="Ledger" asp-route-studentId="@Model.StudentId">View pending challans →</a></aside></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
