@model School_Management_System.ViewModels.FeeChallanDetailsViewModel
@using School_Management_System.Models
@{
    ViewData["Title"] = "Challan Details";
    var c = Model.Challan;
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h2 class="mb-1">@c.ChallanNumber</h2><div class="text-muted">@c.Student.FullName · @c.Student.AdmissionNumber · @c.BillingPeriod</div></div><div class="d-flex flex-wrap gap-2"><a class="btn btn-primary" asp-action="ChallanPdf" asp-route-id="@c.Id">Download PDF</a><a class="btn btn-outline-secondary" asp-action="Ledger" asp-route-studentId="@c.StudentId">Student Ledger</a><a class="btn btn-outline-secondary" asp-action="Challans">Back</a></div></div>
<div class="row g-3 mb-4"><div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted small">Current Charges</div><div class="fs-4">PKR @c.CurrentChargesTotal.ToString("N2")</div></div></div></div><div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted small">Paid</div><div class="fs-4">PKR @c.PaidAmount.ToString("N2")</div></div></div></div><div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted small">This Challan Balance</div><div class="fs-4">PKR @c.Balance.ToString("N2")</div></div></div></div><div class="col-md-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted small">Student Total Outstanding</div><div class="fs-4">PKR @Model.CurrentStudentOutstanding.ToString("N2")</div></div></div></div></div>
<div class="row g-4"><div class="col-lg-8"><div class="card border-0 shadow-sm"><div class="card-header bg-white fw-semibold">Fee Items</div><div class="table-responsive"><table class="table mb-0"><thead class="table-light"><tr><th>Description</th><th>Amount</th><th>Discount</th><th>Net</th></tr></thead><tbody>@foreach(var i in c.Items){<tr><td>@i.Description</td><td>PKR @i.Amount.ToString("N2")</td><td>PKR @i.DiscountAmount.ToString("N2")</td><td>PKR @i.NetAmount.ToString("N2")</td></tr>}</tbody><tfoot><tr class="fw-semibold"><td>Total</td><td>PKR @c.Subtotal.ToString("N2")</td><td>PKR @c.DiscountTotal.ToString("N2")</td><td>PKR @c.CurrentChargesTotal.ToString("N2")</td></tr></tfoot></table></div></div>
<div class="card border-0 shadow-sm mt-4"><div class="card-header bg-white fw-semibold">Payments Allocated</div><div class="table-responsive"><table class="table mb-0"><thead class="table-light"><tr><th>Receipt</th><th>Date</th><th>Amount</th><th>Status</th></tr></thead><tbody>@if(c.PaymentAllocations.Count==0){<tr><td colspan="4" class="text-center text-muted py-3">No payments allocated.</td></tr>}@foreach(var g in c.PaymentAllocations.GroupBy(x=>x.FeePayment).OrderByDescending(x=>x.Key.PaymentDateUtc)){<tr><td><a asp-action="ReceiptPdf" asp-route-id="@g.Key.Id">@g.Key.ReceiptNumber</a></td><td>@g.Key.PaymentDateUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>PKR @g.Sum(x=>x.Amount).ToString("N2")</td><td>@(g.Key.IsReversed?"Reversed":"Posted")</td></tr>}</tbody></table></div></div></div>
<div class="col-lg-4"><div class="card border-0 shadow-sm mb-3"><div class="card-body"><h3 class="h5">Challan Summary</h3><dl class="row mb-0"><dt class="col-6">Status</dt><dd class="col-6">@c.Status</dd><dt class="col-6">Issue</dt><dd class="col-6">@c.IssueDate.ToString("dd MMM yyyy")</dd><dt class="col-6">Due</dt><dd class="col-6">@c.DueDate.ToString("dd MMM yyyy")</dd><dt class="col-6">Previous due at issue</dt><dd class="col-6">PKR @c.PreviousOutstandingAtIssue.ToString("N2")</dd><dt class="col-6">Version</dt><dd class="col-6">@c.Version</dd></dl>@if(c.Balance>0 && c.Status!=FeeChallanStatus.Cancelled && c.Status!=FeeChallanStatus.Waived){<a class="btn btn-success w-100 mt-3" asp-action="CollectPayment" asp-route-studentId="@c.StudentId" asp-route-fromChallanId="@c.Id">Collect Fee</a>}</div></div>
@if(User.IsInRole(AppRoles.SuperAdmin)||User.IsInRole(AppRoles.Principal)||User.IsInRole(AppRoles.Admin)){
<div class="card border-danger shadow-sm"><div class="card-body"><h3 class="h6 text-danger">Controlled Actions</h3><p class="small text-muted">Regeneration/cancellation is blocked while active payments are allocated.</p>
@if(c.Status!=FeeChallanStatus.Cancelled){<form asp-action="Regenerate" method="post" class="mb-3">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Id"/><button class="btn btn-outline-warning w-100" type="submit">Regenerate Challan</button></form><form asp-action="CancelChallan" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Id"/><label class="form-label small">Cancellation reason</label><input class="form-control form-control-sm mb-2" name="reason" required maxlength="500"/><button class="btn btn-outline-danger w-100" type="submit">Cancel Challan</button></form>}
</div></div>}
</div></div>
