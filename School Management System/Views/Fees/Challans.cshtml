@model School_Management_System.ViewModels.ChallansViewModel
@using School_Management_System.Models
@{
    ViewData["Title"] = "Fee Challans";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h2 class="mb-1">Fee Challans</h2><div class="text-muted">Search, collect, print and review student challans.</div></div><div class="d-flex gap-2"><a class="btn btn-primary" asp-action="Generate">Generate</a>@if(Model.BatchId.HasValue){<a class="btn btn-outline-primary" asp-action="BatchPdf" asp-route-id="@Model.BatchId">Download Batch PDF</a>}<a class="btn btn-outline-secondary" asp-action="Index">Fees Home</a></div></div>
<div class="card border-0 shadow-sm mb-3"><div class="card-body"><form method="get" class="row g-2 align-items-end">
<input type="hidden" name="batchId" value="@Model.BatchId" />
<div class="col-md-2"><label class="form-label">Period</label><input class="form-control" type="month" name="billingPeriod" value="@Model.BillingPeriod" /></div>
<div class="col-md-2"><label class="form-label">Status</label><select class="form-select" name="status"><option value="">All</option>@foreach(var x in Enum.GetValues<FeeChallanStatus>()){<option value="@((int)x)" selected="@(Model.Status==x)">@x</option>}</select></div>
<div class="col-md-2"><label class="form-label">Class</label><select class="form-select" name="schoolClassId"><option value="">All</option>@foreach(var x in Model.Classes){<option value="@x.Id" selected="@(Model.SchoolClassId==x.Id)">@x.Text</option>}</select></div>
<div class="col-md-4"><label class="form-label">Search</label><input class="form-control" name="search" value="@Model.Search" placeholder="Challan, student, admission no" /></div>
<div class="col-md-2"><button class="btn btn-primary w-100" type="submit">Filter</button></div>
</form></div></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Challan</th><th>Student</th><th>Period</th><th>Due</th><th>Charges</th><th>Paid</th><th>Balance</th><th>Status</th><th></th></tr></thead><tbody>
@if(Model.Challans.Count==0){<tr><td colspan="9" class="text-center text-muted py-4">No challans found.</td></tr>}
@foreach(var c in Model.Challans){<tr class="@(c.Status==FeeChallanStatus.Cancelled?"table-secondary":"")"><td><a asp-action="ChallanDetails" asp-route-id="@c.Id">@c.ChallanNumber</a>@if(c.Version>1){<div><small class="text-muted">v@c.Version</small></div>}</td><td><div class="fw-semibold">@c.Student.FullName</div><small class="text-muted">@c.Student.AdmissionNumber · @c.ClassNameSnapshot @c.SectionNameSnapshot</small></td><td>@c.BillingPeriod</td><td>@c.DueDate.ToString("dd MMM yyyy")</td><td>PKR @c.CurrentChargesTotal.ToString("N2")</td><td>PKR @c.PaidAmount.ToString("N2")</td><td>PKR @c.Balance.ToString("N2")</td><td><span class="badge @(c.Status==FeeChallanStatus.Paid?"text-bg-success":c.Status==FeeChallanStatus.Overdue?"text-bg-danger":c.Status==FeeChallanStatus.PartiallyPaid?"text-bg-warning":"text-bg-secondary")">@c.Status</span></td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="ChallanPdf" asp-route-id="@c.Id">PDF</a>@if(c.Balance>0 && c.Status!=FeeChallanStatus.Cancelled && c.Status!=FeeChallanStatus.Waived){<a class="btn btn-sm btn-success" asp-action="CollectPayment" asp-route-studentId="@c.StudentId" asp-route-fromChallanId="@c.Id">Collect</a>}</td></tr>}
</tbody></table></div></div>
