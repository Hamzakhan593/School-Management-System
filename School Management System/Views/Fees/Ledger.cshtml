@model School_Management_System.ViewModels.StudentLedgerViewModel
@using School_Management_System.Models
@{
    ViewData["Title"] = "Student Fee Ledger";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h2 class="mb-1">Student Fees</h2><div class="text-muted">Complete challan, payment, balance and reversal history.</div></div><a class="btn btn-outline-secondary" asp-action="Index">Fees Home</a></div>
@if (Model.Student is null) {
<partial name="_StudentSearch" />
<details class="workspace-subsection"><summary>Browse all students</summary><form method="get" class="row g-3"><div class="col-md-9"><label for="studentId" class="form-label">Student</label><select class="form-select" id="studentId" name="studentId" required><option value="">Select student</option>@foreach(var x in Model.StudentOptions){<option value="@x.Id">@x.Text</option>}</select></div><div class="col-md-3 align-self-end"><button class="btn btn-primary" type="submit">View Fees</button></div></form></details>
}
@if(Model.Student is null){<div class="alert alert-info">Select a student to open the ledger.</div>}else{
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h3 class="h5 mb-0">@Model.Student.FullName</h3><small class="text-muted">@Model.Student.AdmissionNumber</small></div>@if(Model.TotalOutstanding>0){<a class="btn btn-success" asp-action="CollectPayment" asp-route-studentId="@Model.Student.Id">Collect Fee</a>}</div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted small">Total Charges</div><div class="fs-4">PKR @Model.TotalCharges.ToString("N2")</div><div class="small text-muted">All billed periods</div></div></div></div><div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted small">Total Posted Payments</div><div class="fs-4">PKR @Model.TotalPaid.ToString("N2")</div><div class="small text-muted">All recorded payments, excluding reversals</div></div></div></div><div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted small">Current Outstanding</div><div class="fs-4">PKR @Model.TotalOutstanding.ToString("N2")</div><div class="small text-muted">As of @DateTime.Today.ToString("dd MMM yyyy")</div></div></div></div></div>
<div class="card border-0 shadow-sm mb-4"><div class="card-header bg-white fw-semibold">Challans</div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Challan</th><th>Period</th><th>Due</th><th>Charges</th><th>Paid</th><th>Balance</th><th>Status</th></tr></thead><tbody>
@if(Model.Challans.Count==0){<tr><td colspan="7" class="text-center text-muted py-3">No challans.</td></tr>}
@foreach(var c in Model.Challans){<tr><td><a asp-action="ChallanDetails" asp-route-id="@c.Id">@c.ChallanNumber</a></td><td>@c.BillingPeriod</td><td>@c.DueDate.ToString("dd MMM yyyy")</td><td>PKR @c.CurrentChargesTotal.ToString("N2")</td><td>PKR @c.PaidAmount.ToString("N2")</td><td>PKR @c.Balance.ToString("N2")</td><td>@c.Status</td></tr>}
</tbody></table></div></div>
<div class="card border-0 shadow-sm"><div class="card-header bg-white fw-semibold">Payments / Receipts</div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Receipt</th><th>Date</th><th>Method</th><th>Amount</th><th>Reference</th><th>Status</th><th>Actions</th></tr></thead><tbody>
@if(Model.Payments.Count==0){<tr><td colspan="7" class="text-center text-muted py-3">No payments.</td></tr>}
@foreach(var p in Model.Payments){<tr class="@(p.IsReversed?"table-secondary":"")"><td><a asp-action="ReceiptPdf" asp-route-id="@p.Id">@p.ReceiptNumber</a></td><td>@p.PaymentDateUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>@p.PaymentMethod</td><td>PKR @p.Amount.ToString("N2")</td><td>@(p.ReferenceNumber??"-")</td><td>@(p.IsReversed?"Reversed":"Posted")</td><td>@if(!p.IsReversed && (User.IsInRole(AppRoles.SuperAdmin)||User.IsInRole(AppRoles.Principal)||User.IsInRole(AppRoles.Admin))){<form asp-action="ReversePayment" method="post" class="d-flex gap-1">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id"/><input type="hidden" name="studentId" value="@Model.Student.Id"/><input class="form-control form-control-sm" name="reason" placeholder="Reason" required maxlength="500"/><button class="btn btn-sm btn-outline-danger" type="submit">Reverse</button></form>}</td></tr>}
</tbody></table></div></div>
}
