<section class="workspace-search" data-student-search>
<h2>Find a student to collect a fee</h2><p class="text-muted">Search by name, admission number, roll number or guardian phone.</p>
<label for="feeStudentSearch" class="form-label">Student search</label><input id="feeStudentSearch" type="search" class="form-control" placeholder="Start typing at least 2 characters…" autocomplete="off" aria-controls="feeSearchResults" />
<div class="workspace-search-results mt-2" id="feeSearchResults" data-results aria-live="polite"></div>
<noscript><p class="mt-2">Use the <a asp-action="Ledger">student selector</a> to find a student.</p></noscript></section>