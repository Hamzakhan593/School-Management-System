@model School_Management_System.ViewModels.ChallanGenerationViewModel
@using School_Management_System.Models
@{
    ViewData["Title"] = "Generate Challans";
    var preview = Model.Preview;
    var printable = (preview?.WillGenerate ?? 0) + (preview?.ExistingPrintable ?? 0);
    var canSetup = User.IsInRole(AppRoles.SuperAdmin) || User.IsInRole(AppRoles.Principal) || User.IsInRole(AppRoles.Admin);
}
<link rel="stylesheet" href="~/css/challan-generation.css" asp-append-version="true" />
<div class="challan-workspace">
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div><div class="text-primary fw-semibold small mb-1">MONTHLY SCHOOL FEES</div><h2 class="mb-2">Generate challans</h2><p class="text-muted mb-0">Choose students, check the fees, then download one ready-to-print PDF.</p></div>
    <a class="btn btn-outline-secondary" asp-action="Challans">View saved challans</a>
</div>
<div class="challan-automation mb-4">
    <div><strong>Monthly automation: @(Model.AutoGenerateEnabled ? "On" : "Off")</strong><div class="small text-muted">@(Model.AutoGenerateEnabled ? $"Challans are automatically prepared from day {Model.GenerationDay} each month while the system is running." : "You can generate this month’s challans below whenever you need them.") Due date: day @Model.DueDay of the fee month (or the last day of a shorter month).</div></div>
    @if(canSetup){<a asp-controller="Settings" asp-action="Index" class="btn btn-sm btn-outline-secondary">Automation settings</a>}
</div>
<form asp-action="Preview" method="post" id="generationForm" class="card border-0 shadow-sm mb-4">
@Html.AntiForgeryToken()
<div class="card-body p-4">
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<fieldset class="mb-4"><legend class="challan-legend"><span class="challan-step">1</span> Who needs a challan?</legend>
<div class="challan-choices">
@foreach(var choice in new[] { (FeeBatchScope.Individual, "One student", "Find a student by name or admission number."), (FeeBatchScope.ClassSection, "A whole class", "All students in a class, or just one section."), (FeeBatchScope.WholeSchool, "Whole school", "All active students in the selected session."), (FeeBatchScope.SelectedStudents, "A few students", "Tick the students you need.") })
{
<label class="challan-choice" for="scope-@((int)choice.Item1)"><input type="radio" asp-for="Scope" id="scope-@((int)choice.Item1)" value="@choice.Item1" /><span><strong>@choice.Item2</strong><small>@choice.Item3</small></span></label>
}
</div>
<div data-scope="Individual" class="mt-3">
<label for="studentSearch" class="form-label">Find a student</label><input id="studentSearch" type="search" class="form-control mb-2" placeholder="Type a name or admission number" />
<label asp-for="StudentId" class="form-label">Student</label><select asp-for="StudentId" class="form-select"><option value="">Choose a student</option>@foreach(var x in Model.Students){<option value="@x.Id">@x.Text</option>}</select>
<p class="form-text">Only students actively enrolled in the chosen school session can receive challans.</p>
</div>
<div data-scope="ClassSection" class="row g-3 mt-1">
<div class="col-md-6"><label asp-for="SchoolClassId" class="form-label">Class</label><select asp-for="SchoolClassId" class="form-select"><option value="">Choose a class</option>@foreach(var x in Model.Classes){<option value="@x.Id">@x.Text</option>}</select></div>
<div class="col-md-6"><label asp-for="SectionId" class="form-label">Section</label><select asp-for="SectionId" class="form-select"><option value="">All sections in this class</option>@foreach(var x in Model.Sections){<option value="@x.Id" data-class="@Model.SectionClasses.GetValueOrDefault(x.Id)">@x.Text</option>}</select></div>
</div>
<div data-scope="WholeSchool" class="challan-note mt-3">Every active student enrolled in the selected session will be checked. Existing challans are reused automatically.</div>
<div data-scope="SelectedStudents" class="mt-3">
<label for="multiSearch" class="form-label">Find and tick students</label><input type="search" id="multiSearch" class="form-control mb-2" placeholder="Search by name, admission number or class" />
<div class="d-flex justify-content-between mb-2"><span id="selectionCount" role="status"></span><button type="button" class="btn btn-sm btn-outline-secondary" id="clearStudents">Clear selection</button></div>
<div class="challan-student-list">@foreach(var x in Model.Students){<label class="challan-student" for="selected-student-@x.Id"><input id="selected-student-@x.Id" type="checkbox" name="SelectedStudentIds" value="@x.Id" checked="@Model.SelectedStudentIds.Contains(x.Id)" /> <span>@x.Text</span></label>}</div>
<p id="noStudentMatches" class="text-muted" hidden>No students match this search.</p>
</div>
</fieldset>
<fieldset><legend class="challan-legend"><span class="challan-step">2</span> Which month?</legend>
<div class="row g-3"><div class="col-md-6"><label for="billingMonthPicker" class="form-label">Fee month</label><input class="form-control" type="month" id="billingMonthPicker" value="@Model.BillingMonth.ToString("yyyy-MM")" required /><input type="hidden" name="BillingMonth" id="billingMonthValue" value="@Model.BillingMonth.ToString("yyyy-MM-01")" /></div>
<div class="col-md-6"><label asp-for="AcademicSessionId" class="form-label">School session</label><select class="form-select" asp-for="AcademicSessionId" required><option value="">Choose a school session</option>@foreach(var x in Model.Sessions){<option value="@x.Id">@x.Text</option>}</select></div></div>
</fieldset>
<div class="challan-note my-3">Fees and discounts come from your saved fee setup. Any unpaid amount from earlier months is included automatically.</div>
<button class="btn btn-primary px-4" type="submit">Check challans <span aria-hidden="true">→</span></button><span class="small text-muted ms-2">Nothing is saved yet.</span>
</div></form>
@if(Model.IsPreview && preview is not null)
{
<section id="challanPreview" class="card border-0 shadow-sm" aria-labelledby="previewTitle">
<div class="card-body p-4">
<h3 id="previewTitle" class="challan-legend" tabindex="-1"><span class="challan-step">3</span> Check &amp; download <span class="text-muted">· @Model.BillingMonth.ToString("MMMM yyyy")</span></h3>
<p class="text-muted">@preview.EligibleStudents active student(s) checked. Each printable challan has Bank, School and Student copies on one page.</p>
<div class="challan-summary mb-3"><div><strong>@preview.WillGenerate</strong><span>New challans</span></div><div><strong>@preview.ExistingPrintable</strong><span>Already saved · included in PDF</span></div><div><strong>@(preview.EligibleStudents - printable)</strong><span>Not included · see reasons below</span></div><div><strong>PKR @preview.EstimatedCurrentCharges.ToString("N0")</strong><span>New fees to save</span></div></div>
@if(preview.EligibleStudents == 0){<div class="alert alert-warning">No active students found for this selection. Check the school session and student enrollment, then try again.</div>}
@if(preview.WillSkipNoStructure > 0){<div class="alert alert-warning">@preview.WillSkipNoStructure student(s) have no payable fees set for this month. Check their class fees, fee dates and discounts. @if(canSetup){<a asp-action="Structures">Open fee setup</a>}else{<span>Ask your school administrator to check fee setup.</span>}</div>}
<div class="table-responsive challan-preview-table"><table class="table align-middle mb-0"><thead><tr><th>Student</th><th>Class</th><th>This month’s fees</th><th>Earlier unpaid fees</th><th>What will happen?</th></tr></thead><tbody>
@foreach(var row in preview.Rows){<tr><td><strong>@row.StudentName</strong><div class="small text-muted">@row.AdmissionNumber</div></td><td>@row.ClassSection</td><td>PKR @row.CurrentCharges.ToString("N2")</td><td>PKR @row.PreviousOutstanding.ToString("N2")</td><td>@row.Result</td></tr>}
</tbody></table></div>
<div id="previewChanged" class="alert alert-warning mt-3" hidden>Your selection changed. Click “Check challans” above to update this preview before downloading.</div>
<form asp-action="Commit" method="post" id="challanCommitForm" class="mt-4">@Html.AntiForgeryToken()
<input type="hidden" name="AcademicSessionId" value="@Model.AcademicSessionId" /><input type="hidden" name="BillingMonth" value="@Model.BillingMonth.ToString("yyyy-MM-dd")" /><input type="hidden" name="Scope" value="@Model.Scope" /><input type="hidden" name="StudentId" value="@Model.StudentId" /><input type="hidden" name="SchoolClassId" value="@Model.SchoolClassId" /><input type="hidden" name="SectionId" value="@Model.SectionId" /><input type="hidden" name="PreviewToken" value="@Model.PreviewToken" />
@foreach(var id in Model.SelectedStudentIds){<input type="hidden" name="SelectedStudentIds" value="@id" />}
<button class="btn btn-primary px-4" type="submit" name="download" value="true" disabled="@(printable == 0)">@(preview.WillGenerate > 0 ? "Save & download" : "Download") @printable challan(s)</button>
<p class="small text-muted mt-2 mb-0">Open the downloaded PDF to print. Downloading again will not add duplicate fees.</p>
</form>
<p id="downloadStatus" class="mt-3 mb-0" role="status" aria-live="polite"></p>
<a id="readyPdf" class="btn btn-outline-primary mt-2" hidden>Download PDF again</a>
</div></section>
}
</div>
@section Scripts { <script src="~/js/challan-generation.js" asp-append-version="true"></script> }
