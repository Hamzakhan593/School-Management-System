@model School_Management_System.ViewModels.DailyCollectionViewModel
@{
    ViewData["Title"] = "Daily Fee Collection";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h2 class="mb-1">Daily Fee Collection</h2><div class="text-muted">Posted and reversed receipts for @Model.Date.ToString("dd MMM yyyy").</div></div><a class="btn btn-outline-secondary" asp-action="Index">Fees Home</a></div>
<div class="card border-0 shadow-sm mb-3"><div class="card-body"><form method="get" class="row g-2 align-items-end"><div class="col-md-4"><label class="form-label">Date</label><input class="form-control" type="date" name="date" value="@Model.Date.ToString("yyyy-MM-dd")"/></div><div class="col-md-2"><button class="btn btn-primary w-100" type="submit">Load</button></div><div class="col-md-6 text-md-end"><div class="text-muted small">Net posted collection</div><div class="fs-4 fw-semibold">PKR @Model.Total.ToString("N2")</div></div></form></div></div>
<div class="row g-3 mb-4"><div class="col-lg-4"><div class="card border-0 shadow-sm h-100"><div class="card-header bg-white fw-semibold">By Payment Method</div><ul class="list-group list-group-flush">@if(Model.TotalsByMethod.Count==0){<li class="list-group-item text-muted">No collection.</li>}@foreach(var x in Model.TotalsByMethod){<li class="list-group-item d-flex justify-content-between"><span>@x.Key</span><strong>PKR @x.Value.ToString("N2")</strong></li>}</ul></div></div><div class="col-lg-4"><div class="card border-0 shadow-sm h-100"><div class="card-header bg-white fw-semibold">By Cashier / User</div><ul class="list-group list-group-flush">@if(Model.TotalsByReceiver.Count==0){<li class="list-group-item text-muted">No collection.</li>}@foreach(var x in Model.TotalsByReceiver){<li class="list-group-item d-flex justify-content-between"><span>@x.Key</span><strong>PKR @x.Value.ToString("N2")</strong></li>}</ul></div></div><div class="col-lg-4"><div class="card border-0 shadow-sm h-100"><div class="card-header bg-white fw-semibold">By Class</div><ul class="list-group list-group-flush">@if(Model.TotalsByClass.Count==0){<li class="list-group-item text-muted">No collection.</li>}@foreach(var x in Model.TotalsByClass){<li class="list-group-item d-flex justify-content-between"><span>@x.Key</span><strong>PKR @x.Value.ToString("N2")</strong></li>}</ul></div></div></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Receipt</th><th>Time</th><th>Student</th><th>Method</th><th>Amount</th><th>Status</th></tr></thead><tbody>
@if(Model.Payments.Count==0){<tr><td colspan="6" class="text-center text-muted py-4">No receipts for this date.</td></tr>}
@foreach(var p in Model.Payments){<tr class="@(p.IsReversed?"table-secondary":"")"><td><a asp-action="ReceiptPdf" asp-route-id="@p.Id">@p.ReceiptNumber</a></td><td>@p.PaymentDateUtc.ToLocalTime().ToString("HH:mm")</td><td>@p.Student.FullName</td><td>@p.PaymentMethod</td><td>PKR @p.Amount.ToString("N2")</td><td>@(p.IsReversed?"Reversed":"Posted")</td></tr>}
</tbody></table></div></div>
