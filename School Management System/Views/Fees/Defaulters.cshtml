@model School_Management_System.ViewModels.DefaulterReportViewModel
@{
    ViewData["Title"] = "Fee Defaulters";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h2 class="mb-1">Fee Defaulter Report</h2><div class="text-muted">Outstanding overdue periods as of @Model.AsOfDate.ToString("dd MMM yyyy").</div></div><div class="d-flex gap-2"><a class="btn btn-outline-primary" asp-action="ExportDefaultersCsv" asp-route-asOfDate="@Model.AsOfDate.ToString("yyyy-MM-dd")">Export CSV</a><a class="btn btn-outline-secondary" asp-action="Index">Fees Home</a></div></div>
<div class="card border-0 shadow-sm mb-3"><div class="card-body"><form method="get" class="row g-2 align-items-end"><div class="col-md-3"><label class="form-label">As of Date</label><input class="form-control" type="date" name="asOfDate" value="@Model.AsOfDate.ToString("yyyy-MM-dd")"/></div><div class="col-md-3"><label class="form-label">Class</label><select class="form-select" name="schoolClassId"><option value="">All classes</option>@foreach(var x in Model.Classes){<option value="@x.Id" selected="@(Model.SchoolClassId==x.Id)">@x.Text</option>}</select></div><div class="col-md-2"><label class="form-label">Min Amount</label><input class="form-control" type="number" step="0.01" name="minimumAmount" value="@Model.MinimumAmount"/></div><div class="col-md-2"><label class="form-label">Min Periods</label><input class="form-control" type="number" min="1" name="minimumOverduePeriods" value="@Model.MinimumOverduePeriods"/></div><div class="col-md-2"><button class="btn btn-primary w-100" type="submit">Filter</button></div></form></div></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Student</th><th>Class</th><th>Overdue Periods</th><th>Oldest Due</th><th>Outstanding</th><th></th></tr></thead><tbody>
@if(Model.Rows.Count==0){<tr><td colspan="6" class="text-center text-muted py-4">No matching defaulters.</td></tr>}
@foreach(var row in Model.Rows){<tr><td><div class="fw-semibold">@row.StudentName</div><small class="text-muted">@row.AdmissionNumber</small></td><td>@row.ClassSection</td><td>@row.OverduePeriods</td><td>@row.OldestDueDate.ToString("dd MMM yyyy")</td><td class="fw-semibold">PKR @row.Outstanding.ToString("N2")</td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Ledger" asp-route-studentId="@row.StudentId">Ledger</a><a class="btn btn-sm btn-success" asp-action="CollectPayment" asp-route-studentId="@row.StudentId">Collect</a></td></tr>}
</tbody></table></div></div>
