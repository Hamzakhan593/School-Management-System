@model School_Management_System.ViewModels.SectionFormViewModel
@{ ViewData["Title"] = "Edit Section"; var classes=(IEnumerable<SchoolClass>)ViewBag.Classes; var teachers=(IEnumerable<ApplicationUser>)ViewBag.Teachers; }
<link rel="stylesheet" href="~/css/classes.css" asp-append-version="true" />
<div class="classes-page">
<h1 class="h3 mb-3">Edit Section</h1>
<div class="classes-panel"><div class="classes-edit-body"><form method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="classes-fields"><div class="classes-field"><label asp-for="SchoolClassId" class="form-label"></label><select asp-for="SchoolClassId" class="form-select">@foreach(var c in classes){<option value="@c.Id">@c.Name</option>}</select></div><div class="classes-field"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div><div class="classes-field"><label asp-for="Capacity" class="form-label"></label><input asp-for="Capacity" class="form-control" /></div><div class="classes-field"><label asp-for="Classroom" class="form-label"></label><input asp-for="Classroom" class="form-control" /></div><div class="classes-field"><label asp-for="ClassTeacherUserId" class="form-label"></label><select asp-for="ClassTeacherUserId" class="form-select"><option value="">None</option>@foreach(var t in teachers){<option value="@t.Id">@t.FullName</option>}</select></div><div class="classes-wide"><div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div></div></div>
<button class="btn btn-primary mt-3">Save</button> <a asp-action="Index" class="btn btn-outline-secondary mt-3">Cancel</a></form></div></div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
