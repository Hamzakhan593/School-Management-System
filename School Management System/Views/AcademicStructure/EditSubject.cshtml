@model School_Management_System.ViewModels.SubjectFormViewModel
@{ ViewData["Title"] = "Edit Subject"; }
<link rel="stylesheet" href="~/css/classes.css" asp-append-version="true" />
<div class="classes-page">
<h1 class="h3 mb-3">Edit Subject</h1>
<div class="classes-panel"><div class="classes-edit-body"><form method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="classes-fields"><div class="classes-field"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" /></div><div class="classes-field"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /></div><div class="classes-field"><label asp-for="DefaultMaxMarks" class="form-label"></label><input asp-for="DefaultMaxMarks" class="form-control" /></div><div class="classes-field"><label asp-for="DefaultPassMarks" class="form-label"></label><input asp-for="DefaultPassMarks" class="form-control" /></div><div class="classes-field"><div class="form-check"><input asp-for="HasTheory" class="form-check-input" /><label asp-for="HasTheory" class="form-check-label"></label></div></div><div class="classes-field"><div class="form-check"><input asp-for="HasPractical" class="form-check-input" /><label asp-for="HasPractical" class="form-check-label"></label></div></div><div class="classes-field"><div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div></div></div>
<button class="btn btn-primary mt-3">Save</button> <a asp-action="Index" class="btn btn-outline-secondary mt-3">Cancel</a></form></div></div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
