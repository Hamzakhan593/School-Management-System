@model School_Management_System.ViewModels.AcademicStructureIndexViewModel
@{
    ViewData["Title"] = "Classes & subjects";
    var canManage = User.IsInRole(AppRoles.SuperAdmin) || User.IsInRole(AppRoles.Principal) || User.IsInRole(AppRoles.Admin);
    var tab = Context.Request.Query["tab"].ToString();
    if (tab != "subjects" && tab != "teachers") { tab = "classes"; }
    var create = Context.Request.Query["create"].ToString();
    var choices = new[] { (Key: "class", Title: "Class", Hint: "For example, Class 6"), (Key: "section", Title: "Section", Hint: "A or B within a class"), (Key: "group", Title: "Group / stream", Hint: "Science, Arts or Computer"), (Key: "subject", Title: "Subject", Hint: "English, Maths or Science") };
}
<link rel="stylesheet" href="~/css/classes.css" asp-append-version="true" />
<div class="classes-page">
<header class="classes-header"><div><span class="classes-eyebrow">SCHOOL ORGANISATION</span><h1>Classes &amp; subjects</h1><p>Create your classes, choose their subjects and assign teachers.</p></div>
<form method="get" class="classes-session"><input type="hidden" name="tab" value="@tab" /><label for="classSession">Academic session</label><div><select id="classSession" name="sessionId" class="form-select">@foreach(var session in Model.Sessions){<option value="@session.Id" selected="@(Model.SelectedSessionId == session.Id)">@session.Name</option>}</select><button class="btn btn-outline-primary">Apply</button></div></form></header>
@if (canManage) {
<section class="classes-panel classes-create" aria-labelledby="createTitle">
<div class="classes-panel-heading"><div><h2 id="createTitle">What would you like to create?</h2><p>Choose one option. Only its form will appear below.</p></div></div>
<div class="classes-choices">
@foreach(var choice in choices) {
<a asp-action="Index" asp-route-sessionId="@Model.SelectedSessionId" asp-route-tab="@tab" asp-route-create="@choice.Key" class="classes-choice" data-create="@choice.Key" aria-current="@(create == choice.Key ? "true" : null)"><strong>@choice.Title</strong><span>@choice.Hint</span><span class="classes-choice-action">Create @choice.Title.ToLowerInvariant() →</span></a>
}
</div>
<p class="classes-prompt" id="createPrompt" hidden="@(choices.Any(x => x.Key == create))">Select Class, Section, Group or Subject to get started.</p>
<div class="classes-create-form" data-create-panel="class" hidden="@(create != "class")"><div class="classes-panel-heading"><div><h3 tabindex="-1">Create a class</h3><p>Give the class a name. You can add sections after saving it.</p></div><a asp-action="Index" asp-route-sessionId="@Model.SelectedSessionId" asp-route-tab="@tab" class="btn btn-outline-secondary" data-close-create>Cancel</a></div><form asp-action="CreateClass" method="post" class="classes-fields">
                    <div class="classes-wide"><label class="form-label" for="academic-1">Name</label><input id="academic-1" name="Name" class="form-control" placeholder="Class name e.g. Grade 6" required /></div>
                    <div class="classes-field"><label class="form-label" for="academic-2">Code</label><input id="academic-2" name="Code" class="form-control" placeholder="Code e.g. G6" /></div>
                    <div class="classes-field"><label class="form-label" for="academic-3">Display order</label><input id="academic-3" name="SortOrder" type="number" class="form-control" value="0" placeholder="Sort order" /></div>
                    <input type="hidden" name="IsActive" value="true" />
                    <div class="classes-form-actions"><button class="btn btn-primary">Add Class</button></div>
                </form></div>
<div class="classes-create-form" data-create-panel="section" hidden="@(create != "section")"><div class="classes-panel-heading"><div><h3 tabindex="-1">Create a section</h3><p>Choose the class this section belongs to, then enter its details.</p></div><a asp-action="Index" asp-route-sessionId="@Model.SelectedSessionId" asp-route-tab="@tab" class="btn btn-outline-secondary" data-close-create>Cancel</a></div><form asp-action="CreateSection" method="post" class="classes-fields">
                    <div class="classes-wide"><label class="form-label" for="academic-4">Class</label><select id="academic-4" name="SchoolClassId" class="form-select" required><option value="">Select class</option>@foreach (var c in Model.Classes.Where(x => x.IsActive)) { <option value="@c.Id">@c.Name</option> }</select></div>
                    <div class="classes-field"><label class="form-label" for="academic-5">Name</label><input id="academic-5" name="Name" class="form-control" placeholder="Section e.g. A" required /></div>
                    <div class="classes-field"><label class="form-label" for="academic-6">Capacity</label><input id="academic-6" name="Capacity" type="number" min="1" class="form-control" value="40" /></div>
                    <div class="classes-field"><label class="form-label" for="academic-7">Classroom</label><input id="academic-7" name="Classroom" class="form-control" placeholder="Room" /></div>
                    <div class="classes-field"><label class="form-label" for="academic-8">Class teacher</label><select id="academic-8" name="ClassTeacherUserId" class="form-select"><option value="">No class teacher</option>@foreach (var t in Model.Teachers) { <option value="@t.Id">@t.FullName</option> }</select></div>
                    <input type="hidden" name="IsActive" value="true" />
                    <div class="classes-form-actions"><button class="btn btn-primary">Add Section</button></div>
                </form></div>
<div class="classes-create-form" data-create-panel="group" hidden="@(create != "group")"><div class="classes-panel-heading"><div><h3 tabindex="-1">Create a group / stream</h3><p>Groups are optional. Use them for streams such as Science or Arts.</p></div><a asp-action="Index" asp-route-sessionId="@Model.SelectedSessionId" asp-route-tab="@tab" class="btn btn-outline-secondary" data-close-create>Cancel</a></div><form asp-action="CreateGroup" method="post" class="classes-fields">
                    <div class="classes-wide"><label class="form-label" for="academic-9">Class</label><select id="academic-9" name="SchoolClassId" class="form-select" required><option value="">Select class</option>@foreach (var c in Model.Classes.Where(x => x.IsActive)) { <option value="@c.Id">@c.Name</option> }</select></div>
                    <div class="classes-wide"><label class="form-label" for="academic-10">Name</label><input id="academic-10" name="Name" class="form-control" placeholder="Science / Arts / Computer" required /></div>
                    <div class="classes-wide"><label class="form-label" for="academic-11">Description</label><input id="academic-11" name="Description" class="form-control" placeholder="Optional description" /></div>
                    <input type="hidden" name="IsActive" value="true" />
                    <div class="classes-form-actions"><button class="btn btn-primary">Add Group</button></div>
                </form></div>
<div class="classes-create-form" data-create-panel="subject" hidden="@(create != "subject")"><div class="classes-panel-heading"><div><h3 tabindex="-1">Create a subject</h3><p>Add a subject to the school list. You can then assign it to a class below.</p></div><a asp-action="Index" asp-route-sessionId="@Model.SelectedSessionId" asp-route-tab="@tab" class="btn btn-outline-secondary" data-close-create>Cancel</a></div><form asp-action="CreateSubject" method="post" class="classes-fields">
            <div class="classes-field"><label class="form-label">Code</label><input name="Code" class="form-control" required /></div>
            <div class="classes-field"><label class="form-label">Title</label><input name="Title" class="form-control" required /></div>
            <div class="classes-field"><label class="form-label">Max marks</label><input name="DefaultMaxMarks" type="number" step="0.01" class="form-control" /></div>
            <div class="classes-field"><label class="form-label">Pass marks</label><input name="DefaultPassMarks" type="number" step="0.01" class="form-control" /></div>
            <div class="classes-field">
                <div class="form-check"><input class="form-check-input" type="checkbox" name="HasTheory" value="true" checked /><label class="form-check-label">Theory</label></div>
                <div class="form-check"><input class="form-check-input" type="checkbox" name="HasPractical" value="true" /><label class="form-check-label">Practical</label></div>
            </div>
            <input type="hidden" name="IsActive" value="true" />
            <div class="classes-form-actions"><button class="btn btn-primary">Add</button></div>
        </form></div>
</section>
}
<nav class="classes-tabs" aria-label="Class organisation">
<a asp-action="Index" asp-route-sessionId="@Model.SelectedSessionId" asp-route-tab="classes" data-tab="classes" aria-current="@(tab == "classes" ? "page" : null)">Classes &amp; sections <span>@Model.Classes.Count</span></a>
<a asp-action="Index" asp-route-sessionId="@Model.SelectedSessionId" asp-route-tab="subjects" data-tab="subjects" aria-current="@(tab == "subjects" ? "page" : null)">Subjects <span>@Model.Subjects.Count</span></a>
<a asp-action="Index" asp-route-sessionId="@Model.SelectedSessionId" asp-route-tab="teachers" data-tab="teachers" aria-current="@(tab == "teachers" ? "page" : null)">Teacher assignments <span>@Model.TeacherAssignments.Count</span></a>
</nav>
<section data-tab-panel="classes" hidden="@(tab != "classes")">
<div class="classes-panel-heading"><div><h2>Your classes</h2><p>Open a student list or manage a class and its sections.</p></div><label class="classes-search">Find a class<input id="classSearch" type="search" class="form-control" placeholder="Search class name" /></label></div>
<div class="classes-directory">
@foreach(var c in Model.Classes) {
<article class="classes-class-card" data-class-card data-name="@c.Name">
<header><div><h3>@c.Name</h3><span>@(string.IsNullOrWhiteSpace(c.Code) ? "Class" : c.Code) · @(c.IsActive ? "Active" : "Inactive")</span></div>@if(canManage){<a class="btn btn-sm btn-outline-secondary" asp-action="EditClass" asp-route-id="@c.Id">Edit class</a>}</header>
<div class="classes-section-list"><h4>Sections <span>@c.Sections.Count</span></h4>
@if(!c.Sections.Any()){<p>No sections added yet.</p>}
@foreach(var sec in c.Sections.OrderBy(x => x.Name)) {
<div class="classes-section-row"><div><strong>Section @sec.Name</strong><small>Capacity: @sec.Capacity@(string.IsNullOrWhiteSpace(sec.Classroom) ? "" : " · Room: " + sec.Classroom)</small></div><div class="classes-row-actions">@if(Model.SelectedSessionId.HasValue){<a class="btn btn-sm btn-outline-primary" asp-action="Roster" asp-route-classId="@c.Id" asp-route-sectionId="@sec.Id" asp-route-sessionId="@Model.SelectedSessionId">Students</a>}@if(canManage){<a class="btn btn-sm btn-outline-secondary" asp-action="EditSection" asp-route-id="@sec.Id">Edit</a>}</div></div>
}
</div>
<div class="classes-group-line"><strong>Groups / streams</strong><span>@(c.Groups.Any() ? string.Join(", ", c.Groups.Select(x => x.Name)) : "None added")</span></div>
@if(Model.SelectedSessionId.HasValue){<a class="btn btn-primary" asp-action="Roster" asp-route-classId="@c.Id" asp-route-sessionId="@Model.SelectedSessionId">View all students</a>}
</article>
}
</div>
@if(!Model.Classes.Any()){<div class="classes-empty">No classes yet. Choose <strong>Class</strong> above to create the first one.</div>}
<p id="noClassMatches" class="classes-empty" hidden>No classes match your search.</p>
@if(Model.LegacyPlacementsUnmapped > 0 && canManage){<details class="classes-panel"><summary>Older student placements need linking (@Model.LegacyPlacementsUnmapped)</summary><form asp-action="MapLegacyPlacements" method="post"><p>Link matching old class names to your classes.</p><button class="btn btn-outline-primary">Link matching placements</button></form></details>}
</section>
<section data-tab-panel="subjects" hidden="@(tab != "subjects")">
<div class="classes-panel"><div class="classes-panel-heading"><div><h2>School subject list</h2><p>These subjects can be used in any class.</p></div></div>
@if(!Model.Subjects.Any()){<p class="classes-empty">No subjects yet. Choose Subject above to add one.</p>}else{
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Subject</th><th>Code</th><th>Type</th><th>Action</th></tr></thead><tbody>@foreach(var subject in Model.Subjects){<tr><td><strong>@subject.Title</strong></td><td>@subject.Code</td><td>@(subject.HasTheory ? "Theory" : "")@(subject.HasPractical ? " Practical" : "")</td><td>@if(canManage){<a class="btn btn-sm btn-outline-secondary" asp-action="EditSubject" asp-route-id="@subject.Id">Edit subject</a>}</td></tr>}</tbody></table></div>}
</div>
@if(Model.SelectedSessionId.HasValue){<div class="classes-panel"><div class="classes-panel-heading"><div><h2>Subjects taught in each class</h2><p>Choose a class and add a subject from your school list.</p></div></div>
@if(canManage){<details class="classes-assignment"><summary>Add a subject to a class</summary><form asp-action="AssignSubject" method="post" class="classes-fields">
                        <input type="hidden" name="AcademicSessionId" value="@Model.SelectedSessionId" />
                        <div class="classes-field"><label class="form-label" for="academic-12">Class</label><select id="academic-12" name="SchoolClassId" class="form-select" required><option value="">Class</option>@foreach (var c in Model.Classes.Where(x => x.IsActive)) { <option value="@c.Id">@c.Name</option> }</select></div>
                        <div class="classes-field"><label class="form-label" for="academic-13">Subject</label><select id="academic-13" name="SubjectId" class="form-select" required><option value="">Subject</option>@foreach (var s in Model.Subjects.Where(x => x.IsActive)) { <option value="@s.Id">@s.Code - @s.Title</option> }</select></div>
                        <div class="classes-field"><label class="form-label" for="academic-14">Maximum marks</label><input id="academic-14" name="MaxMarks" type="number" step="0.01" min="0" class="form-control" placeholder="Use subject default" /></div>
                        <div class="classes-field"><label class="form-label" for="academic-15">Pass marks</label><input id="academic-15" name="PassMarks" type="number" step="0.01" min="0" class="form-control" placeholder="Use subject default" /></div>
                        <div class="classes-form-actions"><button class="btn btn-primary">Assign</button></div>
                    </form></details>}
@if(!Model.ClassSubjects.Any()){<p class="classes-empty">No subjects assigned for this session.</p>}else{<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Class</th><th>Subject</th><th>Maximum / pass marks</th><th>Action</th></tr></thead><tbody>@foreach(var x in Model.ClassSubjects){<tr><td>@x.SchoolClass.Name</td><td>@x.Subject.Title</td><td>@(x.MaxMarks ?? x.Subject.DefaultMaxMarks) / @(x.PassMarks ?? x.Subject.DefaultPassMarks)</td><td>@if(canManage){<form asp-action="RemoveClassSubject" method="post"><input type="hidden" name="id" value="@x.Id" /><button class="btn btn-sm btn-outline-danger">Remove</button></form>}</td></tr>}</tbody></table></div>}
</div>}
</section>
<section data-tab-panel="teachers" hidden="@(tab != "teachers")"><div class="classes-panel"><div class="classes-panel-heading"><div><h2>Teacher assignments</h2><p>Choose who teaches each subject. These assignments control teachers' marks entry.</p></div></div>
@if(canManage && Model.SelectedSessionId.HasValue){<details class="classes-assignment"><summary>Assign a teacher</summary><form asp-action="AssignTeacher" method="post" class="classes-fields">
                        <input type="hidden" name="AcademicSessionId" value="@Model.SelectedSessionId" />
                        <div class="classes-field"><label class="form-label" for="academic-16">Class</label><select id="academic-16" name="SchoolClassId" class="form-select" required><option value="">Class</option>@foreach (var c in Model.Classes.Where(x => x.IsActive)) { <option value="@c.Id">@c.Name</option> }</select></div>
                        <div class="classes-field"><label class="form-label" for="academic-17">Section</label><select id="academic-17" name="SectionId" class="form-select"><option value="">All sections</option>@foreach (var c in Model.Classes) { foreach (var sec in c.Sections.Where(x => x.IsActive)) { <option value="@sec.Id" data-class="@c.Id">@c.Name - @sec.Name</option> } }</select></div>
                        <div class="classes-field"><label class="form-label" for="academic-18">Subject</label><select id="academic-18" name="SubjectId" class="form-select" required><option value="">Subject</option>@foreach (var s in Model.Subjects.Where(x => x.IsActive)) { <option value="@s.Id" data-classes="@string.Join(",", Model.ClassSubjects.Where(x => x.SubjectId == s.Id && x.IsActive).Select(x => x.SchoolClassId))">@s.Title</option> }</select></div>
                        <div class="classes-field"><label class="form-label" for="academic-19">Teacher</label><select id="academic-19" name="TeacherUserId" class="form-select" required><option value="">Teacher</option>@foreach (var t in Model.Teachers) { <option value="@t.Id">@t.FullName</option> }</select></div>
                        <div class="classes-wide"><small class="text-muted">Only subjects added to this class are available. Choose All sections if the teacher teaches the entire class.</small></div>
                        <div class="classes-form-actions"><button class="btn btn-primary">Assign Teacher</button></div>
                    </form></details>}
@if(!Model.TeacherAssignments.Any()){<p class="classes-empty">No teachers assigned for this session. Add subjects to a class first, then assign its teachers.</p>}else{<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Teacher</th><th>Class / section</th><th>Subject</th><th>Action</th></tr></thead><tbody>@foreach(var x in Model.TeacherAssignments){<tr><td>@x.TeacherUser.FullName</td><td>@x.SchoolClass.Name · @(x.Section?.Name ?? "All sections")</td><td>@x.Subject.Title</td><td>@if(canManage){<form asp-action="RemoveTeacherAssignment" method="post"><input type="hidden" name="id" value="@x.Id" /><button class="btn btn-sm btn-outline-danger">Remove assignment</button></form>}</td></tr>}</tbody></table></div>}
</div></section>
</div>
@section Scripts { <script src="~/js/academic-structure.js" asp-append-version="true"></script> }
