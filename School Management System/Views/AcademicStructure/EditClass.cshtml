@model School_Management_System.ViewModels.SchoolClassFormViewModel
@{ ViewData["Title"] = "Edit Class"; }
<link rel="stylesheet" href="~/css/classes.css" asp-append-version="true" />
<div class="classes-page">
<h1 class="h3 mb-3">Edit Class</h1>
<div class="classes-panel"><div class="classes-edit-body"><form method="post">
<input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="classes-fields"><div class="classes-field"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div><div class="classes-field"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" /></div><div class="classes-field"><label asp-for="SortOrder" class="form-label"></label><input asp-for="SortOrder" class="form-control" /></div><div class="classes-field"><div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div></div></div>
<button class="btn btn-primary mt-3">Save</button> <a asp-action="Index" class="btn btn-outline-secondary mt-3">Cancel</a>
</form></div></div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
