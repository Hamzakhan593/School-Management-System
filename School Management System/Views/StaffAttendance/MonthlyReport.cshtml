@model School_Management_System.ViewModels.StaffAttendanceMonthlyReportViewModel
@{
    ViewData["Title"] = "Staff Attendance Report";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div><h1 class="h3 mb-1">Staff Attendance Report</h1><p class="text-muted mb-0">Monthly attendance summary by employee.</p></div>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to Daily Attendance</a>
</div>
<div class="card shadow-sm mb-4"><div class="card-body">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-4"><label class="form-label">Month</label><input class="form-control" type="month" name="month" value="@Model.Month.ToString("yyyy-MM")" /></div>
        <div class="col-md-2"><button class="btn btn-primary w-100">Load</button></div>
    </form>
</div></div>
<div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead class="table-light"><tr><th>Employee</th><th>Department</th><th>Present</th><th>Absent</th><th>Late</th><th>Leave</th><th>Half Day</th><th>Holiday</th><th>Marked Days</th></tr></thead>
    <tbody>
    @if (Model.Rows.Count == 0) { <tr><td colspan="9" class="text-center text-muted py-5">No staff records found.</td></tr> }
    else
    {
        @foreach (var row in Model.Rows)
        {
            <tr><td><strong>@row.StaffName</strong><div class="small text-muted">@row.EmployeeId</div></td><td>@(row.Department ?? "—")</td><td>@row.PresentDays</td><td>@row.AbsentDays</td><td>@row.LateDays</td><td>@row.LeaveDays</td><td>@row.HalfDays</td><td>@row.HolidayDays</td><td>@row.TotalMarkedDays</td></tr>
        }
    }
    </tbody>
</table></div></div>
